 bazel_dep(name = "fmt", version = "12.1.0")
 bazel_dep(name = "spdlog", version = "1.17.0")
-# TBB comes from the cmake-built @onetbb repo (bazel/deps.bzl), not the BCR
-# onetbb module: Naja's native targets and the kepler-formal binary must
-# share a single libtbb.so.12 runtime. The same install tree is exported
-# for the plain CMake flow by //:deps.
+# TBB from the BCR module rather than the cmake-built @onetbb overlay. Both
+# build the same upstream tarball (uxlfoundation/oneTBB v2022.3.0); the BCR one
+# is a plain cc_library, so it needs no rules_foreign_cc and therefore no cmake
+# or make on the host. The overlay's stated reason -- that Naja's
+# find_package(TBB) needs TBBConfig.cmake, and that Naja's shared libraries and
+# the binary must share one libtbb.so.12 -- does not apply to the Bazel flow:
+# Naja is built here as a native cc_library (bazel/naja.BUILD.bazel), never
+# through CMake, so find_package never runs and there are no Naja .so files to
+# share a runtime with. //:deps and the plain CMake flow are unaffected.
+bazel_dep(name = "onetbb", version = "2022.3.0")
 
