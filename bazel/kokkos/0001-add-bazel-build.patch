diff --git a/MODULE.bazel b/MODULE.bazel
new file mode 100644
--- /dev/null
+++ b/MODULE.bazel
@@ -0,0 +1,11 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# Copyright (c) 2026, The OpenROAD Authors
+
+module(
+    name = "kokkos",
+    version = "4.7.02",
+)
+
+bazel_dep(name = "bazel_skylib", version = "1.7.1")
+bazel_dep(name = "openmp", version = "21.1.5.bcr.2")
+bazel_dep(name = "rules_cc", version = "0.2.18")
diff --git a/BUILD.bazel b/BUILD.bazel
new file mode 100644
--- /dev/null
+++ b/BUILD.bazel
@@ -0,0 +1,128 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# Copyright (c) 2026, The OpenROAD Authors
+
+load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
+load("@bazel_skylib//rules:write_file.bzl", "write_file")
+load("@rules_cc//cc:cc_library.bzl", "cc_library")
+
+package(default_visibility = ["//visibility:public"])
+
+string_flag(
+    name = "backend",
+    build_setting_default = "openmp",
+    values = [
+        "openmp",
+        "serial",
+        "threads",
+    ],
+)
+
+config_setting(
+    name = "openmp",
+    flag_values = {":backend": "openmp"},
+)
+
+config_setting(
+    name = "threads",
+    flag_values = {":backend": "threads"},
+)
+
+# Mirror the host configuration generated by Kokkos 4.7.02's CMake build.
+write_file(
+    name = "config",
+    out = "KokkosCore_config.h",
+    content = [
+        "#define KOKKOS_VERSION 40702",
+        "#define KOKKOS_VERSION_MAJOR 4",
+        "#define KOKKOS_VERSION_MINOR 7",
+        "#define KOKKOS_VERSION_PATCH 2",
+        "#define KOKKOS_ENABLE_SERIAL",
+        "#define KOKKOS_ENABLE_CXX20",
+        "#define KOKKOS_ENABLE_DEPRECATED_CODE_4",
+        "#define KOKKOS_ENABLE_COMPLEX_ALIGN",
+        "#define KOKKOS_ENABLE_IMPL_MDSPAN",
+        "#define KOKKOS_ENABLE_IMPL_VIEW_LEGACY",
+        "#define KOKKOS_ENABLE_IMPL_REF_COUNT_BRANCH_UNLIKELY",
+        "",
+    ] + select({
+        ":openmp": ["#define KOKKOS_ENABLE_OPENMP"],
+        ":threads": ["#define KOKKOS_ENABLE_THREADS"],
+        "//conditions:default": [],
+    }),
+)
+
+write_file(
+    name = "declare_backend",
+    out = "KokkosCore_Config_DeclareBackend.hpp",
+    content = ["#include <decl/Kokkos_Declare_SERIAL.hpp>"] + select({
+        ":openmp": ["#include <decl/Kokkos_Declare_OPENMP.hpp>"],
+        ":threads": ["#include <decl/Kokkos_Declare_THREADS.hpp>"],
+        "//conditions:default": [],
+    }),
+)
+
+write_file(
+    name = "fwd_backend",
+    out = "KokkosCore_Config_FwdBackend.hpp",
+    content = ["#include <fwd/Kokkos_Fwd_SERIAL.hpp>"] + select({
+        ":openmp": ["#include <fwd/Kokkos_Fwd_OPENMP.hpp>"],
+        ":threads": ["#include <fwd/Kokkos_Fwd_THREADS.hpp>"],
+        "//conditions:default": [],
+    }),
+)
+
+write_file(
+    name = "setup_backend",
+    out = "KokkosCore_Config_SetupBackend.hpp",
+    content = [""],
+)
+
+write_file(
+    name = "desul_config",
+    out = "desul/atomics/Config.hpp",
+    content = ["#pragma once"],
+)
+
+cc_library(
+    name = "kokkos",
+    srcs = glob([
+        "core/src/impl/*.cpp",
+        "core/src/Serial/*.cpp",
+        "containers/src/impl/*.cpp",
+    ]) + select({
+        ":openmp": glob(["core/src/OpenMP/*.cpp"]),
+        ":threads": glob(["core/src/Threads/*.cpp"]),
+        "//conditions:default": [],
+    }),
+    hdrs = glob([
+        "core/src/**/*.hpp",
+        "core/src/**/*.h",
+        "containers/src/**/*.hpp",
+        "algorithms/src/**/*.hpp",
+        "tpls/desul/include/**",
+        "tpls/mdspan/include/**",
+    ]) + [
+        ":config",
+        ":declare_backend",
+        ":desul_config",
+        ":fwd_backend",
+        ":setup_backend",
+    ],
+    copts = select({
+        ":openmp": ["-fopenmp"],
+        "//conditions:default": [],
+    }),
+    includes = [
+        ".",
+        "algorithms/src",
+        "containers/src",
+        "core/src",
+        "tpls/desul/include",
+        "tpls/mdspan/include",
+    ],
+    linkopts = ["-pthread"],
+    deps = select({
+        ":openmp": ["@openmp"],
+        "//conditions:default": [],
+    }),
+)
