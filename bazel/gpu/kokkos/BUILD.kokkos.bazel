load("@openroad//bazel/gpu:copts.bzl", "CUDA_ARCH_COPTS", "CUDA_TOOLKIT_COPTS")
load("@openroad//bazel/gpu/kokkos:configure.bzl", "kokkos_config")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The headers Kokkos's CMake build would have generated (KokkosCore_config.h,
# the KokkosCore_Config_*Backend.hpp include lists, desul's Config.hpp),
# written at build time from the backend list in configure.bzl.
kokkos_config(name = "config")

cc_library(
    name = "kokkos",
    # Keep the per-backend sources in step with KOKKOS_BACKENDS in
    # configure.bzl: core/src/<Backend>/*.cpp for each enabled backend
    # (core/src/CMakeLists.txt), plus desul's lock array for the device one.
    srcs = [
        "algorithms/src/KokkosAlgorithms_dummy.cpp",
        "containers/src/impl/Kokkos_UnorderedMap_impl.cpp",
        "core/src/Cuda/Kokkos_CudaSpace.cpp",
        "core/src/Cuda/Kokkos_Cuda_Instance.cpp",
        "core/src/OpenMP/Kokkos_OpenMP.cpp",
        "core/src/OpenMP/Kokkos_OpenMP_Instance.cpp",
        "core/src/Serial/Kokkos_Serial.cpp",
        "core/src/impl/Kokkos_Abort.cpp",
        "core/src/impl/Kokkos_CPUDiscovery.cpp",
        "core/src/impl/Kokkos_Command_Line_Parsing.cpp",
        "core/src/impl/Kokkos_Core.cpp",
        "core/src/impl/Kokkos_Error.cpp",
        "core/src/impl/Kokkos_ExecPolicy.cpp",
        "core/src/impl/Kokkos_HostBarrier.cpp",
        "core/src/impl/Kokkos_HostSpace.cpp",
        "core/src/impl/Kokkos_HostSpace_deepcopy.cpp",
        "core/src/impl/Kokkos_HostThreadTeam.cpp",
        "core/src/impl/Kokkos_MemoryPool.cpp",
        "core/src/impl/Kokkos_Profiling.cpp",
        "core/src/impl/Kokkos_SharedAlloc.cpp",
        "core/src/impl/Kokkos_Stacktrace.cpp",
        "core/src/impl/Kokkos_hwloc.cpp",
        "simd/src/Kokkos_SIMD_dummy.cpp",
        "tpls/desul/src/Lock_Array_CUDA.cpp",
    ],
    hdrs = glob([
        "algorithms/src/**/*.hpp",
        "containers/src/**/*.hpp",
        "core/src/**/*.h",
        "core/src/**/*.hpp",
        "simd/src/**/*.hpp",
        "tpls/desul/include/**/*.hpp",
        "tpls/desul/include/**/*.inc*",
        "tpls/mdspan/include/**/*.hpp",
    ]),
    additional_compiler_inputs = ["@cuda_local//:compiler_inputs"],
    # Kokkos needs the common toolkit and architecture flags, but not gpl's
    # placement-new shim from CUDA_COPTS. -fopenmp is the compiler flag the
    # OpenMP backend (KOKKOS_ENABLE_OPENMP) needs, OpenMP::OpenMP_CXX in
    # Kokkos's CMake, paired with the @openmp runtime below. CMake propagates that flag to every Kokkos consumer; Bazel copts
    # do not, so each target that includes Kokkos headers must pass -fopenmp
    # itself (CUDA_COPTS does), or Kokkos_OpenMP_Instance.hpp stops with
    # "You enabled Kokkos OpenMP support without enabling OpenMP".
    copts = CUDA_TOOLKIT_COPTS + CUDA_ARCH_COPTS + ["-fopenmp"],
    includes = [
        "algorithms/src",
        "containers/src",
        "core/src",
        "simd/src",
        "tpls/desul/include",
        "tpls/mdspan/include",
    ],
    linkopts = ["-ldl"],
    deps = [
        ":config",
        "@cuda_local//:cudart",
        "@openmp",
    ],
)
