"""KokkosFFT_config.hpp for the GPU build's registry KokkosFFT.

KokkosFFT's CMake build writes KokkosFFT_config.hpp into its build tree;
the registry module takes it through the @kokkos_fft//:config label_flag.
kokkos_fft_config() below writes OpenROAD's version at build time, so no
generated file is checked in. Kokkos itself is configured through the
registry module's --@kokkos//:* flags (see .bazelrc).

Recompare whenever the KokkosFFT version in MODULE.bazel changes:
  - kokkos-fft/cmake/KokkosFFT_config.hpp.in
  - kokkos-fft/CMakeLists.txt, kokkos-fft/cmake/KokkosFFT_tpls.cmake (TPLs)
"""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

KOKKOSFFT_VERSION = (2, 0, 0)

# FFTW for the host plus cuFFT for Kokkos's CUDA device backend.
KOKKOSFFT_TPLS = ["FFTW", "CUFFT"]

def _defines(names):
    return ["#define " + name for name in names]

def _kokkos_fft_config():
    """KokkosFFT_config.hpp with FFTW and cuFFT enabled.

    This matches a KokkosFFT CMake configure with KokkosFFT_ENABLE_FFTW=ON;
    KokkosFFT's own default turns FFTW off once a device backend is enabled,
    but gpl runs its FFTs on the host. @fftw does not build FFTW's threads
    library, so host plans must use Kokkos::Serial.
    """
    major, minor, patch = KOKKOSFFT_VERSION
    return [
        "// SPDX-FileCopyrightText: (C) The Kokkos-FFT development team, see COPYRIGHT.md file",
        "//",
        "// SPDX-License-Identifier: MIT OR Apache-2.0 WITH LLVM-exception",
        "",
        "// Generated by @openroad//bazel/gpu/kokkos:configure.bzl; do not edit.",
        "",
        "#ifndef KOKKOSFFT_CONFIG_HPP",
        "#define KOKKOSFFT_CONFIG_HPP",
        "",
        "#define KOKKOSFFT_VERSION %d" % (major * 10000 + minor * 100 + patch),
        "#define KOKKOSFFT_VERSION_MAJOR %d" % major,
        "#define KOKKOSFFT_VERSION_MINOR %d" % minor,
        "#define KOKKOSFFT_VERSION_PATCH %d" % patch,
        "",
    ] + _defines(["KOKKOSFFT_ENABLE_TPL_" + tpl for tpl in KOKKOSFFT_TPLS]) + [
        "",
        "#endif",
        "",
    ]

def kokkos_fft_config(name, **kwargs):
    """cc_library `name` serving <name>/KokkosFFT_config.hpp as KokkosFFT_config.hpp."""
    out = name + "/KokkosFFT_config.hpp"
    write_file(
        name = name + "_KokkosFFT_config_hpp",
        out = out,
        content = _kokkos_fft_config(),
    )
    cc_library(
        name = name,
        hdrs = [out],
        strip_include_prefix = name,
        **kwargs
    )
