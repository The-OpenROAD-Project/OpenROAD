load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "kokkos_fft",
    hdrs = glob([
        "common/src/**/*.hpp",
        "fft/src/**/*.hpp",
    ]),
    includes = [
        "common/src",
        "fft/src",
    ],
    deps = [
        "@cuda_local//:cufft",
        "@fftw",
        "@kokkos",
        "@openroad//bazel/kokkos:fft_config",
    ],
)
