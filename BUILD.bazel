    name = "profile_linux",
    match_all = [
        ":profile_enabled",
        "@platforms//os:linux",
    ],
)

# LLD gives rodata and code different vaddr-offset deltas; profilers that
# assume a single load bias (e.g. VTune) then misresolve every symbol.
# --no-rosegment merges the two into one segment. ELF-only, so Linux only.
OPENROAD_LINKOPTS = select({
    ":profile_linux": ["-Wl,--no-rosegment"],
    "//conditions:default": [],
})

# Opt-in GPU build (see build:gpu in .bazelrc and bazel/gpu/system_gpu.bzl).
# A string flag rather than a bool leaves room for other backends such as
# "hip".
string_flag(
    name = "gpu",
    build_setting_default = "none",
    values = [
        "none",
        "cuda",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "gpu_cuda",
    flag_values = {
        ":gpu": "cuda",
    },
    visibility = ["//visibility:public"],
)

# CUDA code generation and the Kokkos configuration must use the same target.
# "none" makes plain --config=gpu fail with an actionable message instead of
# silently producing kernels for the wrong device.
string_flag(
    name = "cuda_arch",
    build_setting_default = "none",
    values = ["none"] + CUDA_ARCHS,
    visibility = ["//visibility:public"],
)

[
    config_setting(
        name = "cuda_arch_" + arch,
        flag_values = {":cuda_arch": arch},
        visibility = ["//visibility:public"],
    )
    for arch in CUDA_ARCHS
]

