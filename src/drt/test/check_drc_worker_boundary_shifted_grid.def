VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN witness ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 50000 24000 ) ;
GCELLGRID X 0 DO 13 STEP 4000 ;
GCELLGRID Y 0 DO 7 STEP 4000 ;
COMPONENTS 0 ;
END COMPONENTS
PINS 0 ;
END PINS
NETS 1 ;
- witness_net
  + USE SIGNAL
  + ROUTED metal2 ( 27290 2740 ) ( 27290 3300 )
    NEW metal2 ( 27290 3300 ) ( 27670 3300 )
    NEW metal2 ( 27290 3020 ) via2_5 ;
END NETS
END DESIGN
