VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 40000 40000 ) ;
ROW ROW_0 unithd 5060 5440 N DO 65 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 5060 8160 FS DO 65 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 5060 10880 N DO 65 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 5060 13600 FS DO 65 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 5060 16320 N DO 65 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 5060 19040 FS DO 65 BY 1 STEP 460 0 ;
ROW ROW_6 unithd 5060 21760 N DO 65 BY 1 STEP 460 0 ;
ROW ROW_7 unithd 5060 24480 FS DO 65 BY 1 STEP 460 0 ;
ROW ROW_8 unithd 5060 27200 N DO 65 BY 1 STEP 460 0 ;
ROW ROW_9 unithd 5060 29920 FS DO 65 BY 1 STEP 460 0 ;
TRACKS X 230 DO 87 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 117 STEP 340 LAYER li1 ;
TRACKS X 170 DO 117 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 117 STEP 340 LAYER met1 ;
TRACKS X 230 DO 87 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 87 STEP 460 LAYER met2 ;
TRACKS X 340 DO 59 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 59 STEP 680 LAYER met3 ;
TRACKS X 460 DO 43 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 43 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 12 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 12 STEP 3400 LAYER met5 ;
GCELLGRID X 0 DO 5 STEP 6900 ;
GCELLGRID Y 0 DO 5 STEP 6900 ;
COMPONENTS 1 ;
    - u1 sky130_fd_sc_hd__probec_p_8 + PLACED ( 15180 19040 ) N ;
END COMPONENTS
PINS 2 ;
    - in + NET in + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 20470 242 ) N ;
    - out + NET out + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 19550 242 ) N ;
END PINS
NETS 2 ;
    - in ( PIN in ) ( u1 A ) + USE SIGNAL
      + ROUTED met2 ( 20470 340 0 ) ( * 1020 )
      NEW met2 ( 20010 1020 ) ( 20470 * )
      NEW met2 ( 20010 1020 ) ( * 19550 )
      NEW met1 ( 16330 19550 ) ( 20010 * )
      NEW met1 ( 16330 19550 ) ( * 20230 )
      NEW met1 ( 20010 19550 ) M1M2_PR
      NEW li1 ( 16330 20230 ) L1M1_PR_MR ;
    - out ( PIN out ) ( u1 X ) + USE SIGNAL
      + ROUTED met2 ( 19550 340 0 ) ( * 6460 )
      NEW met3 ( 17020 6460 ) ( 19550 * )
      NEW met4 ( 17020 6460 ) ( * 20400 0 )
      NEW met2 ( 19550 6460 ) M2M3_PR
      NEW met3 ( 17020 6460 ) M3M4_PR ;
END NETS
END DESIGN
