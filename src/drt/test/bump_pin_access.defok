VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN bump_pin_access ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 40000 40000 ) ;
TRACKS X 190 DO 142 STEP 280 LAYER metal1 ;
TRACKS Y 140 DO 143 STEP 280 LAYER metal1 ;
TRACKS X 190 DO 105 STEP 380 LAYER metal2 ;
TRACKS Y 140 DO 105 STEP 380 LAYER metal2 ;
TRACKS X 190 DO 142 STEP 280 LAYER metal3 ;
TRACKS Y 140 DO 143 STEP 280 LAYER metal3 ;
TRACKS X 190 DO 71 STEP 560 LAYER metal4 ;
TRACKS Y 140 DO 71 STEP 560 LAYER metal4 ;
TRACKS X 190 DO 71 STEP 560 LAYER metal5 ;
TRACKS Y 140 DO 71 STEP 560 LAYER metal5 ;
TRACKS X 190 DO 71 STEP 560 LAYER metal6 ;
TRACKS Y 140 DO 71 STEP 560 LAYER metal6 ;
TRACKS X 1790 DO 24 STEP 1600 LAYER metal7 ;
TRACKS Y 1740 DO 24 STEP 1600 LAYER metal7 ;
TRACKS X 1790 DO 24 STEP 1600 LAYER metal8 ;
TRACKS Y 1740 DO 24 STEP 1600 LAYER metal8 ;
TRACKS X 3390 DO 12 STEP 3200 LAYER metal9 ;
TRACKS Y 3340 DO 12 STEP 3200 LAYER metal9 ;
TRACKS X 3390 DO 12 STEP 3200 LAYER metal10 ;
TRACKS Y 3340 DO 12 STEP 3200 LAYER metal10 ;
GCELLGRID X 0 DO 7 STEP 5700 ;
GCELLGRID Y 0 DO 7 STEP 5700 ;
COMPONENTS 1 ;
    - bump1 TEST_BUMP + FIXED ( 25000 15000 ) N ;
END COMPONENTS
PINS 1 ;
    - a + NET n1 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER metal2 ( -200 -200 ) ( 200 200 )
        + FIXED ( 5000 20000 ) N ;
END PINS
NETS 1 ;
    - n1 ( PIN a ) ( bump1 PAD ) + USE SIGNAL
      + ROUTED metal2 ( 5130 19740 ) ( * 20020 0 )
      NEW metal3 ( 5130 19740 ) ( 28750 * )
      NEW metal6 ( 28750 19340 ) ( * 19740 )
      NEW metal7 ( 28750 19340 ) ( 28990 * )
      NEW metal2 ( 5130 19740 ) via2_5
      NEW metal3 ( 28750 19740 ) via3_2
      NEW metal4 ( 28750 19740 ) via4_0
      NEW metal5 ( 28750 19740 ) via5_0
      NEW metal6 ( 28750 19340 ) via6_0
      NEW metal7 ( 28990 19340 ) via7_0
      NEW metal8 ( 28990 19340 ) via8_0
      NEW metal9 ( 28990 19340 ) via9_0 ;
END NETS
END DESIGN
