VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN macro_pin_escape_test ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 50000 50000 ) ;

TRACKS X 190 DO 132 STEP 380 LAYER metal1 ;
TRACKS Y 140 DO 179 STEP 280 LAYER metal1 ;
TRACKS X 190 DO 132 STEP 380 LAYER metal2 ;
TRACKS Y 140 DO 179 STEP 280 LAYER metal2 ;
TRACKS X 190 DO 132 STEP 380 LAYER metal3 ;
TRACKS Y 140 DO 179 STEP 280 LAYER metal3 ;
TRACKS X 190 DO 89 STEP 560 LAYER metal4 ;
TRACKS Y 140 DO 90 STEP 560 LAYER metal4 ;
TRACKS X 190 DO 89 STEP 560 LAYER metal5 ;
TRACKS Y 140 DO 90 STEP 560 LAYER metal5 ;
TRACKS X 190 DO 89 STEP 560 LAYER metal6 ;
TRACKS Y 140 DO 90 STEP 560 LAYER metal6 ;
TRACKS X 190 DO 32 STEP 1600 LAYER metal7 ;
TRACKS Y 140 DO 32 STEP 1600 LAYER metal7 ;
TRACKS X 190 DO 32 STEP 1600 LAYER metal8 ;
TRACKS Y 140 DO 32 STEP 1600 LAYER metal8 ;
TRACKS X 190 DO 16 STEP 3200 LAYER metal9 ;
TRACKS Y 140 DO 16 STEP 3200 LAYER metal9 ;
TRACKS X 190 DO 16 STEP 3200 LAYER metal10 ;
TRACKS Y 140 DO 16 STEP 3200 LAYER metal10 ;

COMPONENTS 1 ;
  - macro macro_pin_escape + FIXED ( 20080 20000 ) N ;
END COMPONENTS

PINS 1 ;
  - out + NET net + DIRECTION OUTPUT + USE SIGNAL
    + PORT
      + LAYER metal3 ( -500 -500 ) ( 500 500 )
      + FIXED ( 45000 30000 ) N ;
END PINS

NETS 1 ;
  - net ( PIN out ) ( macro A ) + USE SIGNAL ;
END NETS

END DESIGN
