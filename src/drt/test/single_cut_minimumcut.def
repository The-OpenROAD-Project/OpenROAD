VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN single_cut_minimumcut ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 40000 40000 ) ;
PINS 2 ;
    - a + NET n1 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER metal2 ( -70 -70 ) ( 70 70 )
        + FIXED ( 5000 20000 ) N ;
    - b + NET n1 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER metal4 ( -2000 -2000 ) ( 2000 2000 )
        + FIXED ( 30000 20000 ) N ;
END PINS
NETS 1 ;
    - n1 ( PIN a ) ( PIN b ) + USE SIGNAL ;
END NETS
END DESIGN
