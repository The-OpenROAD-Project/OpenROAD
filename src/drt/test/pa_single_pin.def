VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN pa_single_pin_test ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 1480000 2130000 ) ( 1500000 2160000 ) ;

ROW ROW_0 gf180mcu_osu_sc_gp12t3v3 1490000 2141400 N DO 22 BY 1 STEP 200 0 ;

TRACKS X 1479520 DO 25 STEP 1120 LAYER Metal1 ;
TRACKS Y 2129120 DO 30 STEP 1120 LAYER Metal1 ;
TRACKS X 1479520 DO 25 STEP 1120 LAYER Metal2 ;
TRACKS Y 2129120 DO 30 STEP 1120 LAYER Metal2 ;
TRACKS X 1479520 DO 25 STEP 1120 LAYER Metal3 ;
TRACKS Y 2129120 DO 30 STEP 1120 LAYER Metal3 ;
TRACKS X 1479520 DO 25 STEP 1120 LAYER Metal4 ;
TRACKS Y 2129120 DO 30 STEP 1120 LAYER Metal4 ;
TRACKS X 1479600 DO 20 STEP 1800 LAYER Metal5 ;
TRACKS Y 2129400 DO 20 STEP 1800 LAYER Metal5 ;

COMPONENTS 1 ;
    - u1 gf180mcu_osu_sc_gp12t3v3__tieh + PLACED ( 1490000 2141400 ) N ;
END COMPONENTS

PINS 1 ;
    - Y_OUT + NET n1 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER Metal2 ( -500 -500 ) ( 500 500 )
        + PLACED ( 1494400 2149700 ) N ;
END PINS

NETS 1 ;
    - n1 ( PIN Y_OUT ) ( u1 Y ) + USE SIGNAL ;
END NETS

END DESIGN
