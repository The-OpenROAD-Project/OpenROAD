allow_congestion             false
congestion_iterations        10 *
congestion_report_iter_step  0
congestion_report_file       
grid_origin                  {5 5} *
critical_nets_percentage     none
res_aware_nets_percentage    none
resistance_aware             false
snapshot_batched_width       0
