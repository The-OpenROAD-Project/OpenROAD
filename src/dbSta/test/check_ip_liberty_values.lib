  cell (lib_scalar_zero) {
    area : 1;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Z) {
      direction : output;
      function : "A";
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (arc_template) {
          values ("0.10, 0.20", "0.15, 0.25");
        }
        rise_transition (scalar) {
          values ("0.0");
        }
        cell_fall (arc_template) {
          values ("0.10, 0.20", "0.15, 0.25");
        }
        fall_transition (arc_template) {
          values ("0.05, 0.10", "0.08, 0.15");
        }
      }
    }
    pg_pin (VDD) {
      pg_type : primary_power;
      voltage_name : VDD;
    }
  }

  cell (lib_scalar_long) {
    area : 1;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Z) {
      direction : output;
      function : "A";
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (arc_template) {
          values ("0.10, 0.20", "0.15, 0.25");
        }
        rise_transition (scalar) {
          values ("1.50");
        }
        cell_fall (arc_template) {
          values ("0.10, 0.20", "0.15, 0.25");
        }
        fall_transition (arc_template) {
          values ("0.05, 0.10", "0.08, 0.15");
        }
      }
    }
    pg_pin (VDD) {
      pg_type : primary_power;
      voltage_name : VDD;
    }
  }

  cell (lib_tristate_disable) {
    area : 1;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (EN) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Z) {
      direction : output;
      function : "A";
      three_state : "!EN";
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (arc_template) {
          values ("0.10, 0.20", "0.15, 0.25");
        }
        rise_transition (arc_template) {
          values ("0.05, 0.10", "0.08, 0.15");
        }
        cell_fall (arc_template) {
          values ("0.10, 0.20", "0.15, 0.25");
        }
        fall_transition (arc_template) {
          values ("0.05, 0.10", "0.08, 0.15");
        }
      }
      timing () {
        related_pin : "EN";
        timing_type : three_state_enable;
        timing_sense : positive_unate;
        cell_rise (arc_template) {
          values ("0.10, 0.20", "0.15, 0.25");
        }
        rise_transition (arc_template) {
          values ("0.05, 0.10", "0.08, 0.15");
        }
        cell_fall (arc_template) {
          values ("0.10, 0.20", "0.15, 0.25");
        }
        fall_transition (arc_template) {
          values ("0.05, 0.10", "0.08, 0.15");
        }
      }
      timing () {
        related_pin : "EN";
        timing_type : three_state_disable;
        timing_sense : negative_unate;
        cell_rise (scalar) {
          values ("0.10");
        }
        rise_transition (scalar) {
          values ("0.0");
        }
        cell_fall (scalar) {
          values ("0.10");
        }
        fall_transition (scalar) {
          values ("0.0");
        }
      }
    }
    pg_pin (VDD) {
      pg_type : primary_power;
      voltage_name : VDD;
    }
  }
