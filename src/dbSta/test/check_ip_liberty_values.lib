  cell (lib_rounding_at_limit) {
    area : 1;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Z) {
      direction : output;
      function : "A";
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (arc_template) {
          values ("0.10, 0.20", "0.15, 0.25");
