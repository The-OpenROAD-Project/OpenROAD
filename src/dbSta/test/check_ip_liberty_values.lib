  cell (lib_pin_max_transition) {
    area : 1;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Z) {
      direction : output;
      max_transition : 3.0;
      function : "A";
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (arc_template) {
          values ("0.10, 0.20", "0.15, 0.25");
        }
        rise_transition (arc_template) {
          values ("1.20, 1.60", "1.40, 2.50");
        }
        cell_fall (arc_template) {
          values ("0.10, 0.20", "0.15, 0.25");
        }
        fall_transition (arc_template) {
          values ("0.05, 0.10", "0.08, 0.15");
        }
      }
    }
    pg_pin (VDD) {
      pg_type : primary_power;
      voltage_name : VDD;
    }
  }

  cell (lib_just_above_limit) {
    area : 1;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Z) {
      direction : output;
      function : "A";
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (arc_template) {
          values ("0.10, 0.20", "0.15, 0.25");
        }
        rise_transition (arc_template) {
          values ("1.001, 1.20", "1.10, 1.30");
        }
        cell_fall (arc_template) {
