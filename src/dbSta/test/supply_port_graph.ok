--- write_verilog -include_pwr_gnd (assign aliases must stay) ---
module top (in1,
    out1,
    vccd1,
    vccd2,
    vssd1,
    vssd2);
 input in1;
 output out1;
 inout vccd1;
 inout vccd2;
 inout vssd1;
 inout vssd2;

 wire vdpwr;
 wire vgnd;

 BUF_X1 u1 (.A(in1),
    .Z(out1));
 assign vccd1 = vdpwr;
 assign vccd2 = vdpwr;
 assign vssd1 = vgnd;
 assign vssd2 = vgnd;
endmodule
