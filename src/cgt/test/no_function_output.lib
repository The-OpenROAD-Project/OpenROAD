/* Cell whose output pin has no function (like a power-gating filler). */
library (no_function_output) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, ff);
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  nom_process : 1.0;
  nom_voltage : 1.1;
  nom_temperature : 25.0;

  cell (NOFUNC_X1) {
    area : 1.0;
    pin (A) {
      direction : input;
      capacitance : 1.0;
    }
    pin (Z) {
      direction : output;
    }
  }
}
