VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN cugr_colocated_pins ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 60000 60000 ) ;
TRACKS X 190 DO 158 STEP 380 LAYER metal1 metal2 metal3 ;
TRACKS Y 140 DO 214 STEP 280 LAYER metal1 metal2 metal3 ;
PINS 4 ;
  - lower_m1 + NET test_net + DIRECTION INPUT + USE SIGNAL
    + LAYER metal1 ( -70 -70 ) ( 70 70 ) + PLACED ( 14700 14700 ) N ;
  - lower_m3 + NET test_net + DIRECTION OUTPUT + USE SIGNAL
    + LAYER metal3 ( -70 -70 ) ( 70 70 ) + PLACED ( 14700 14700 ) N ;
  - upper_m1 + NET test_net + DIRECTION OUTPUT + USE SIGNAL
    + LAYER metal1 ( -70 -70 ) ( 70 70 ) + PLACED ( 14700 44100 ) N ;
  - upper_m3 + NET test_net + DIRECTION OUTPUT + USE SIGNAL
    + LAYER metal3 ( -70 -70 ) ( 70 70 ) + PLACED ( 14700 44100 ) N ;
END PINS
NETS 1 ;
  - test_net ( PIN lower_m1 ) ( PIN lower_m3 )
             ( PIN upper_m1 ) ( PIN upper_m3 ) ;
END NETS
END DESIGN
