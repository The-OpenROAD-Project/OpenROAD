VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN cugr_detour_limit ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 68400 68400 ) ;
TRACKS X 190 DO 180 STEP 380 LAYER metal1 metal2 metal3 ;
TRACKS Y 140 DO 244 STEP 280 LAYER metal1 metal2 metal3 ;
PINS 2 ;
  - source + NET test_net + DIRECTION INPUT + USE SIGNAL
    + LAYER metal3 ( -70 -70 ) ( 70 70 ) + PLACED ( 8550 31350 ) N ;
  - sink + NET test_net + DIRECTION OUTPUT + USE SIGNAL
    + LAYER metal3 ( -70 -70 ) ( 70 70 ) + PLACED ( 54150 31350 ) N ;
END PINS
BLOCKAGES 3 ;
  - LAYER metal3 RECT ( 17100 28785 ) ( 45600 33915 ) ;
  - LAYER metal3 RECT ( 17100 23343 ) ( 45600 25514 ) ;
  - LAYER metal3 RECT ( 17100 34743 ) ( 45600 36914 ) ;
END BLOCKAGES
NETS 1 ;
  - test_net ( PIN source ) ( PIN sink ) ;
END NETS
END DESIGN
