library(comb_loop_cells) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit(1, pf);

  /* Two independent paths: Y depends only on A, Z only on B. */
  cell(DUAL) {
    area : 2;
    pin(A) {
      direction : input;
      capacitance : 0.001;
    }
    pin(B) {
      direction : input;
      capacitance : 0.001;
    }
    pin(Y) {
      direction : output;
      function : "A";
    }
    pin(Z) {
      direction : output;
      function : "B";
    }
  }

  /* Y is combinational; Z has no function (opaque). */
  cell(HALF) {
    area : 2;
    pin(A) {
      direction : input;
      capacitance : 0.001;
    }
    pin(Y) {
      direction : output;
      function : "A";
    }
    pin(Z) {
      direction : output;
    }
  }
}
