VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 20000 20000 ) ;
ROW ROW_0 core 2000 3200 N DO 80 BY 1 STEP 200 0 ;
ROW ROW_1 core 2000 4800 FS DO 80 BY 1 STEP 200 0 ;
ROW ROW_2 core 2000 6400 N DO 80 BY 1 STEP 200 0 ;
ROW ROW_3 core 2000 8000 FS DO 80 BY 1 STEP 200 0 ;
ROW ROW_4 core 2000 9600 N DO 80 BY 1 STEP 200 0 ;
