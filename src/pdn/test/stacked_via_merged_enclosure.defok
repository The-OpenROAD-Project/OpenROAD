ROW ROW_6 core 2000 12800 N DO 80 BY 1 STEP 200 0 ;
ROW ROW_7 core 2000 14400 FS DO 80 BY 1 STEP 200 0 ;
ROW ROW_8 core 2000 16000 N DO 80 BY 1 STEP 200 0 ;
VIAS 2 ;
    - via1_2_1000_200_1_3_340_340 + VIARULE V12_GEN + CUTSIZE 140 140  + LAYERS MET1 V12 MET2  + CUTSPACING 200 200  + ENCLOSURE 20 30 50 50  + ROWCOL 1 3  ;
    - via2_3_1000_200_1_3_340_340 + VIARULE V23_GEN + CUTSIZE 140 140  + LAYERS MET2 V23 MET3  + CUTSPACING 200 200  + ENCLOSURE 0 90 90 20  + ROWCOL 1 3  ;
END VIAS
COMPONENTS 0 ;
END COMPONENTS
PINS 2 ;
