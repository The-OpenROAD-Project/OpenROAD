VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN pdn_via_end_to_end ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 10000 400 ) ;

ROW ROW_0 EOL_SITE 0 0 N DO 50 BY 1 STEP 200 0 ;

COMPONENTS 4 ;
  - ends_apart EOL_CELL + PLACED ( 2000 0 ) N ;
  - ends_close EOL_CELL + PLACED ( 4000 0 ) N ;
  - end_to_wide EOL_CELL + PLACED ( 6000 0 ) N ;
  - ends_offset EOL_CELL + PLACED ( 8000 0 ) N ;
END COMPONENTS

SPECIALNETS 1 ;
  - VSS + USE GROUND
    + ROUTED metal1 0 + SHAPE STRIPE ( 2100 310 ) narrow_via
      NEW metal1 0 + SHAPE STRIPE ( 4100 270 ) narrow_via
      NEW metal1 0 + SHAPE STRIPE ( 6100 310 ) wide_via
      NEW metal1 0 + SHAPE STRIPE ( 8150 270 ) narrow_via ;
END SPECIALNETS
END DESIGN
