VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN row_site_mismatch ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 20000 20000 ) ;

ROW CORE_ROW_0 FreePDK45_38x28_10R_NP_162NW_34O 3800 2800 FS DO 32 BY 1 STEP 380 0 ;

COMPONENTS 1 ;
    - _0_ BUF_X4 + PLACED ( 3800 2800 ) FS ;
END COMPONENTS

PINS 2 ;
    - input + NET input + DIRECTION INPUT + USE SIGNAL + FIXED ( 0 -140 ) N + LAYER metal6 ( -140 -140 ) ( 140 140 ) ;
    - out + NET out + DIRECTION OUTPUT + USE SIGNAL + FIXED ( 0 60 ) N + LAYER metal6 ( -140 -140 ) ( 140 140 ) ;
END PINS

NETS 2 ;
    - input ( PIN input ) ( _0_ A ) + USE SIGNAL ;
    - out ( PIN out ) ( _0_ Z ) + USE SIGNAL ;
END NETS

END DESIGN
