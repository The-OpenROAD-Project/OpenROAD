VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN pdn_via ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 28000 12000 ) ;
ROW ROW_0 FreePDK45_38x28_10R_NP_162NW_34O 3800 5600 N DO 52 BY 1 STEP 380 0 ;
COMPONENTS 4 ;
  - blocked BUF_X4 + PLACED ( 3800 5600 ) N ;
  - same_net BUF_X4 + PLACED ( 7600 5600 ) N ;
  - signal_blocked BUF_X4 + PLACED ( 11400 5600 ) N ;
  - signal_same_net BUF_X4 + PLACED ( 15200 5600 ) N ;
END COMPONENTS
SPECIALNETS 1 ;
  - VSS ( * VSS ) ( signal_same_net A ) + USE GROUND
    + ROUTED metal1 0 + SHAPE STRIPE ( 4380 5800 ) via1_0
      NEW metal1 0 + SHAPE STRIPE ( 7680 5600 ) via1_0
      NEW metal1 0 + SHAPE STRIPE ( 11560 6800 ) via1_0
      NEW metal1 0 + SHAPE STRIPE ( 15360 6800 ) via1_0 ;
END SPECIALNETS
END DESIGN
