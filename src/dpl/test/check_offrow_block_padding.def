VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 20000 14000 ) ;
ROW row_0 core 0 0 N DO 100 BY 1 STEP 200 0 ;
ROW row_1 core 0 1400 FS DO 100 BY 1 STEP 200 0 ;
ROW row_2 core 0 2800 N DO 100 BY 1 STEP 200 0 ;
ROW row_3 core 0 4200 FS DO 100 BY 1 STEP 200 0 ;
ROW row_4 core 0 5600 N DO 100 BY 1 STEP 200 0 ;
ROW row_5 core 0 7000 FS DO 100 BY 1 STEP 200 0 ;
ROW row_6 core 0 8400 N DO 100 BY 1 STEP 200 0 ;
ROW row_7 core 0 9800 FS DO 100 BY 1 STEP 200 0 ;
ROW row_8 core 0 11200 N DO 100 BY 1 STEP 200 0 ;
ROW row_9 core 0 12600 FS DO 100 BY 1 STEP 200 0 ;
COMPONENTS 2 ;
  - ram RAM + FIXED ( 2000 3600 ) N ;
  - inv INV + PLACED ( 4000 8400 ) N ;
END COMPONENTS
END DESIGN
