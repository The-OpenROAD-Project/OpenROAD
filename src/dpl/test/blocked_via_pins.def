VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN blocked_via_pins ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 7560 3780 ) ;
ROW ROW_0 asap7sc7p5t 2160 540 N DO 100 BY 1 STEP 54 0 ;
ROW ROW_1 asap7sc7p5t 2160 810 FS DO 100 BY 1 STEP 54 0 ;
ROW ROW_2 asap7sc7p5t 2160 1080 N DO 100 BY 1 STEP 54 0 ;
ROW ROW_3 asap7sc7p5t 2160 1350 FS DO 100 BY 1 STEP 54 0 ;
ROW ROW_4 asap7sc7p5t 2160 1620 N DO 100 BY 1 STEP 54 0 ;
ROW ROW_5 asap7sc7p5t 2160 1890 FS DO 100 BY 1 STEP 54 0 ;
ROW ROW_6 asap7sc7p5t 2160 2160 N DO 100 BY 1 STEP 54 0 ;
ROW ROW_7 asap7sc7p5t 2160 2430 FS DO 100 BY 1 STEP 54 0 ;
ROW ROW_8 asap7sc7p5t 2160 2700 N DO 100 BY 1 STEP 54 0 ;
ROW ROW_9 asap7sc7p5t 2160 2970 FS DO 100 BY 1 STEP 54 0 ;
COMPONENTS 3 ;
    - mid_cell M3PIN_MID + PLACED ( 3240 1080 ) N ;
    - left_cell M3PIN_LEFT + PLACED ( 3132 540 ) N ;
    - m1_cell INVx1_ASAP7_75t_R + PLACED ( 5184 540 ) N ;
END COMPONENTS
NETS 1 ;
    - n1 ( left_cell A ) ( m1_cell Y ) ;
END NETS
END DESIGN
