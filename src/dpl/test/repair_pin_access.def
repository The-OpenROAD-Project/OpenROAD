VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN pdn_first_hop ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 8000 1000 ) ;
ROW ROW_0 core_site 0 0 N DO 20 BY 1 STEP 400 0 ;
TRACKS X 0 DO 40 STEP 200 LAYER M1 ;
TRACKS Y 100 DO 5 STEP 200 LAYER M1 ;
TRACKS X 0 DO 20 STEP 400 LAYER M2 ;
TRACKS Y 100 DO 5 STEP 200 LAYER M2 ;
TRACKS X 0 DO 40 STEP 200 LAYER M3 ;
TRACKS Y 100 DO 5 STEP 200 LAYER M3 ;
COMPONENTS 2 ;
  - u phase_cell + PLACED ( 0 0 ) N ;
  - v phase_cell + PLACED ( 4000 0 ) N ;
END COMPONENTS
PINS 2 ;
  - OUT + NET n + DIRECTION OUTPUT + USE SIGNAL
    + PORT + LAYER M2 ( -50 -100 ) ( 50 100 )
    + PLACED ( 1600 500 ) N ;
  - OUT2 + NET n2 + DIRECTION OUTPUT + USE SIGNAL
    + PORT + LAYER M2 ( -50 -100 ) ( 50 100 )
    + PLACED ( 5600 500 ) N ;
END PINS
NETS 2 ;
  - n ( PIN OUT ) ( u A ) + USE SIGNAL ;
  - n2 ( PIN OUT2 ) ( v A ) + USE SIGNAL ;
END NETS
SPECIALNETS 1 ;
  - VDD + USE POWER
    + ROUTED M2 0 + SHAPE STRIPE ( 400 500 ) V23
    NEW M2 0 + SHAPE STRIPE ( 4400 500 ) V23 ;
END SPECIALNETS
END DESIGN
