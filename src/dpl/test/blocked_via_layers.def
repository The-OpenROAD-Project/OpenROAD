VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN blocked_via_layers ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 5400 2700 ) ;
ROW ROW_0 asap7sc7p5t 0 0 N DO 100 BY 1 STEP 54 0 ;
ROW ROW_1 asap7sc7p5t 0 270 FS DO 100 BY 1 STEP 54 0 ;
ROW ROW_2 asap7sc7p5t 0 540 N DO 100 BY 1 STEP 54 0 ;
ROW ROW_3 asap7sc7p5t 0 810 FS DO 100 BY 1 STEP 54 0 ;
ROW ROW_4 asap7sc7p5t 0 1080 N DO 100 BY 1 STEP 54 0 ;
ROW ROW_5 asap7sc7p5t 0 1350 FS DO 100 BY 1 STEP 54 0 ;
ROW ROW_6 asap7sc7p5t 0 1620 N DO 100 BY 1 STEP 54 0 ;
ROW ROW_7 asap7sc7p5t 0 1890 FS DO 100 BY 1 STEP 54 0 ;
ROW ROW_8 asap7sc7p5t 0 2160 N DO 100 BY 1 STEP 54 0 ;
ROW ROW_9 asap7sc7p5t 0 2430 FS DO 100 BY 1 STEP 54 0 ;
COMPONENTS 3 ;
    - m3_cell M3PIN + PLACED ( 1080 0 ) N ;
    - m3_open M3PIN + PLACED ( 1080 540 ) N ;
    - m1_cell INVx1_ASAP7_75t_R + PLACED ( 1134 270 ) FS ;
END COMPONENTS
NETS 1 ;
    - n1 ( m3_cell A ) ( m1_cell Y ) ;
END NETS
END DESIGN
