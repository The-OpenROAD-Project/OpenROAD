VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN pdn_via_array ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 28000 14000 ) ;
ROW ROW_0 FreePDK45_38x28_10R_NP_162NW_34O 0 5600 N DO 72 BY 1 STEP 380 0 ;
ROW ROW_1 FreePDK45_38x28_10R_NP_162NW_34O 0 8400 FS DO 72 BY 1 STEP 380 0 ;
COMPONENTS 6 ;
    - after_repeat SUPPLY_CACHE_CELL + PLACED ( 25840 5600 ) N ;
    - blocked_left SUPPLY_CACHE_CELL + PLACED ( 23180 5600 ) N ;
    - blocked_right SUPPLY_CACHE_CELL + PLACED ( 24700 5600 ) N ;
    - gap_boundary SUPPLY_CACHE_CELL + PLACED ( 23940 5600 ) N ;
    - mirrored_blocked SUPPLY_CACHE_CELL + PLACED ( 23940 8400 ) FS ;
    - same_net SUPPLY_CACHE_CELL + PLACED ( 25080 8400 ) FS ;
END COMPONENTS
SPECIALNETS 1 ;
    - VSS ( same_net VSS ) + USE GROUND
      + ROUTED metal1 0 + SHAPE STRIPE ( 23750 7000 ) via1_0
      NEW metal1 0 + SHAPE STRIPE ( 23750 9800 ) via1_0
      NEW metal1 0 + SHAPE STRIPE ( 24510 7000 ) via1_0
      NEW metal1 0 + SHAPE STRIPE ( 24510 9800 ) via1_0
      NEW metal1 0 + SHAPE STRIPE ( 25270 7000 ) via1_0
      NEW metal1 0 + SHAPE STRIPE ( 25270 9800 ) via1_0 ;
END SPECIALNETS
NETS 0 ;
END NETS
END DESIGN
