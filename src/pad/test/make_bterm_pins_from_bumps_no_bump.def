VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 400000 400000 ) ;
COMPONENTS 1 ;
- drv0 INV_X1 + PLACED ( 20000 20000 ) N ;
END COMPONENTS
PINS 1 ;
- out0 + NET out0 + DIRECTION OUTPUT + USE SIGNAL ;
END PINS
NETS 1 ;
- out0 ( PIN out0 ) ( drv0 ZN ) ;
END NETS
END DESIGN
