VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 400000 400000 ) ;
COMPONENTS 2 ;
    - bump0 DUMMY_BUMP + PLACED ( 100000 100000 ) N ;
    - drv0 INV_X1 + PLACED ( 20000 20000 ) N ;
END COMPONENTS
PINS 2 ;
    - in0 + NET in0 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER metal10 ( -45000 -45000 ) ( 45000 45000 )
        + FIXED ( 145000 145000 ) N ;
    - out0 + NET out0 + DIRECTION OUTPUT + USE SIGNAL ;
END PINS
NETS 2 ;
    - in0 ( PIN in0 ) ( bump0 PAD ) + USE SIGNAL ;
    - out0 ( PIN out0 ) ( drv0 ZN ) + USE SIGNAL ;
END NETS
END DESIGN
