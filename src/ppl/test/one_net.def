VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN one_net ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 20000 20000 ) ;
TRACKS X 190 DO 52 STEP 380 LAYER metal2 ;
TRACKS Y 140 DO 71 STEP 280 LAYER metal2 ;
TRACKS X 190 DO 52 STEP 380 LAYER metal3 ;
TRACKS Y 140 DO 71 STEP 280 LAYER metal3 ;
COMPONENTS 1 ;
    - u1 BUF_X1 + PLACED ( 9500 9520 ) N ;
END COMPONENTS
PINS 1 ;
    - in1 + NET n1 + DIRECTION INPUT + USE SIGNAL ;
END PINS
NETS 1 ;
    - n1 ( PIN in1 ) ( u1 A ) ;
END NETS
END DESIGN
