VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN met4_two_widths ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 20000 20000 ) ;
NONDEFAULTRULES 1 ;
- wide + LAYER li1 WIDTH 170 + LAYER met1 WIDTH 140 + LAYER met2 WIDTH 140
  + LAYER met3 WIDTH 300 + LAYER met4 WIDTH 600 + LAYER met5 WIDTH 1600 ;
END NONDEFAULTRULES
PINS 4 ;
- a_in + NET a + DIRECTION INPUT + USE SIGNAL
  + LAYER met4 ( -150 -150 ) ( 150 150 ) + PLACED ( 5000 2000 ) N ;
- a_out + NET a + DIRECTION OUTPUT + USE SIGNAL
  + LAYER met4 ( -150 -150 ) ( 150 150 ) + PLACED ( 5000 18000 ) N ;
- b_in + NET b + DIRECTION INPUT + USE SIGNAL
  + LAYER met4 ( -300 -300 ) ( 300 300 ) + PLACED ( 10000 2000 ) N ;
- b_out + NET b + DIRECTION OUTPUT + USE SIGNAL
  + LAYER met4 ( -300 -300 ) ( 300 300 ) + PLACED ( 10000 18000 ) N ;
END PINS
NETS 2 ;
- a ( PIN a_in ) ( PIN a_out ) + USE SIGNAL
  + ROUTED met4 ( 5000 2000 ) ( 5000 18000 ) ;
- b ( PIN b_in ) ( PIN b_out ) + USE SIGNAL + NONDEFAULTRULE wide
  + ROUTED met4 ( 10000 2000 ) ( 10000 18000 ) ;
END NETS
END DESIGN
