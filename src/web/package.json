{
  "name": "openroad-web",
  "private": true,
  "type": "module",
  "description": "Browser libraries for the web viewer, bundled by esbuild into the assets embedded in the OpenROAD binary (issue #11065).",
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/extensions": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "golden-layout": "2.6.0",
    "lit": "^3.3.3",
    "netlistsvg": "1.0.2",
    "three": "0.160.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "overrides": {
      "@deck.gl/core>@types/offscreencanvas": "-",
      "@deck.gl/layers>@types/geojson": "-",
      "@loaders.gl/schema-utils>@types/geojson": "-",
      "@loaders.gl/schema>@types/geojson": "-",
      "@luma.gl/core>@types/offscreencanvas": "-",
      "apache-arrow>@types/node": "-",
      "lit-html>@types/trusted-types": "-",
      "netlistsvg>@types/clone": "-",
      "netlistsvg>@types/json5": "-",
      "netlistsvg>@types/lodash": "-",
      "netlistsvg>ajv": "-",
      "netlistsvg>ajv-errors": "-",
      "netlistsvg>fs-extra": "-",
      "netlistsvg>json5": "-",
      "netlistsvg>yargs": "-"
    }
  }
}
