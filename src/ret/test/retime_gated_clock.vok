module top (a,
    b,
    clk,
    en,
    y,
    z);
 input a;
 input b;
 input clk;
 input en;
 output y;
 output z;

 wire gclk;
 wire k1n;
 wire k2n;
 wire k3n;
 wire m1;
 wire m2;
 wire m3;
 wire m4;
 wire mx;
 wire n0;
 wire pa;
 wire pb;
 wire q1;
 wire q2;
 wire qa;
 wire qb;
 wire qc;
 wire ret_net_0;

 AND2_X1 g0 (.A1(a),
    .A2(b),
    .ZN(n0));
 AND2_X1 g_mix (.A1(qa),
    .A2(qb),
    .ZN(mx));
 INV_X1 h1 (.A(q1),
    .ZN(m1));
 INV_X1 h2 (.A(m1),
    .ZN(m2));
 INV_X1 h3 (.A(m2),
    .ZN(m3));
 INV_X1 h4 (.A(ret_net_0),
    .ZN(m4));
 CLKGATE_X1 icg (.CK(clk),
    .E(en),
    .GCK(gclk));
 INV_X1 k1 (.A(mx),
    .ZN(k1n));
 INV_X1 k2 (.A(k1n),
    .ZN(k2n));
 INV_X1 k3 (.A(k2n),
    .ZN(k3n));
 BUF_X1 o1 (.A(q2),
    .Z(y));
 BUF_X1 o2 (.A(qc),
    .Z(z));
 INV_X1 p0 (.A(a),
    .ZN(pa));
 INV_X1 p1 (.A(b),
    .ZN(pb));
 DFF_X1 r1 (.D(n0),
    .CK(gclk),
    .Q(q1));
 DFF_X1 r2 (.D(m4),
    .CK(gclk),
    .Q(q2));
 DFF_X1 ra (.D(pa),
    .CK(clk),
    .Q(qa));
 DFF_X1 rb (.D(pb),
    .CK(gclk),
    .Q(qb));
 DFF_X1 rc (.D(k3n),
    .CK(clk),
    .Q(qc));
 DFF_X1 ret_ff_0 (.D(m3),
    .CK(gclk),
    .Q(ret_net_0));
endmodule
