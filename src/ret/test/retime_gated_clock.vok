module top (a,
    b,
    clk,
    en,
    w,
    y,
    z);
 input a;
 input b;
 input clk;
 input en;
 output w;
 output y;
 output z;

 wire gclk;
 wire k1n;
 wire k2n;
 wire k3n;
 wire m1;
 wire m2;
 wire m3;
 wire m4;
 wire mx;
 wire mx2;
 wire n0;
 wire pa;
 wire pb;
 wire ret_net_1;
 wire q2;
 wire qa;
 wire qb;
 wire qc;
 wire qs2;
 wire qs3;
 wire s1n;
 wire sa;
 wire sb;
 wire t1n;
 wire t2n;
 wire t3n;
 wire t4n;
 wire ret_net_0;

 AND2_X1 g0 (.A1(a),
    .A2(b),
    .ZN(n0));
 AND2_X1 g_mix (.A1(qa),
    .A2(qb),
    .ZN(mx));
 AND2_X1 g_mix2 (.A1(ret_net_1),
    .A2(qs2),
    .ZN(mx2));
 INV_X1 h1 (.A(n0),
    .ZN(m1));
 INV_X1 h2 (.A(m1),
    .ZN(m2));
 INV_X1 h3 (.A(m2),
    .ZN(m3));
 INV_X1 h4 (.A(ret_net_0),
    .ZN(m4));
 CLKGATE_X1 icg (.CK(clk),
    .E(en),
    .GCK(gclk));
 INV_X1 k1 (.A(mx),
    .ZN(k1n));
 INV_X1 k2 (.A(k1n),
    .ZN(k2n));
 INV_X1 k3 (.A(k2n),
    .ZN(k3n));
 BUF_X1 o1 (.A(q2),
    .Z(y));
 BUF_X1 o2 (.A(qc),
    .Z(z));
 BUF_X1 o3 (.A(qs3),
    .Z(w));
 INV_X1 p0 (.A(a),
    .ZN(pa));
 INV_X1 p1 (.A(b),
    .ZN(pb));
 DFF_X1 r2 (.D(m4),
    .CK(gclk),
    .Q(q2));
 DFF_X1 ra (.D(pa),
    .CK(clk),
    .Q(qa));
 DFF_X1 rb (.D(pb),
    .CK(gclk),
    .Q(qb));
 DFF_X1 rc (.D(k3n),
    .CK(clk),
    .Q(qc));
 DFF_X1 ret_ff_0 (.D(m3),
    .CK(gclk),
    .Q(ret_net_0));
 DFF_X1 ret_ff_1 (.D(s1n),
    .CK(clk),
    .Q(ret_net_1));
 DFF_X1 rs2 (.D(sb),
    .CK(gclk),
    .Q(qs2));
 DFF_X1 rs3 (.D(t4n),
    .CK(clk),
    .Q(qs3));
 INV_X1 s0 (.A(a),
    .ZN(sa));
 INV_X1 s1 (.A(sa),
    .ZN(s1n));
 INV_X1 s2 (.A(b),
    .ZN(sb));
 INV_X1 t1 (.A(mx2),
    .ZN(t1n));
 INV_X1 t2 (.A(t1n),
    .ZN(t2n));
 INV_X1 t3 (.A(t2n),
    .ZN(t3n));
 INV_X1 t4 (.A(t3n),
    .ZN(t4n));
endmodule
