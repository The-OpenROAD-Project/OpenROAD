module top (a,
    b,
    clk,
    en_i,
    rst_n,
    y);
 input a;
 input b;
 input clk;
 input en_i;
 input rst_n;
 output y;

 wire d1;
 wire d2;
 wire d3;
 wire en;
 wire n1;
 wire n2;
 wire n3;
 wire n4;
 wire n5;
 wire n6;
 wire n7;
 wire n8;
 wire q3;
 wire ret_net_2;
 wire ret_net_1;
 wire rst;

 sky130_fd_sc_hd__and2_1 g0 (.A(a),
    .B(rst_n),
    .X(d1));
 sky130_fd_sc_hd__and2_1 g1 (.A(b),
    .B(rst_n),
    .X(d2));
 sky130_fd_sc_hd__and2_1 g10 (.A(n8),
    .B(rst_n),
    .X(d3));
 sky130_fd_sc_hd__buf_1 g11 (.A(q3),
