/* ========================================================================== */
/* sequnmap_tie_multi.lib: hand sized liberty for unit testing SequentialUnmapper. */
/* Tie discovery, multi output case: MULTIE has HI and LO on one cell, the sky130 conb_1 shape, */
/* and the SMALLEST area, so both tie slots must select it and mkTie must pick the pin by stored mterm. */
/* DFF_P_TIE0 and DFF_P_TIE1 carry constant leaves 0 and 1 to reach the tie builder. */
/* DFF_P, INV, AND2, OR2 are the support cells prepare needs. */
/* No timing tables on purpose: decompose reads FUNCTIONS, not delays. */
/* ========================================================================== */
library (sequnmap_tie_multi) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, pf);
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  default_fanout_load : 1.0;
  default_inout_pin_cap : 0.001;
  default_input_pin_cap : 0.001;
  default_output_pin_cap : 0.0;

  cell (INV) {
    area : 1.0;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Y) {
      direction : output;
      function : "!A";
    }
  }

  cell (AND2) {
    area : 2.0;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (B) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Y) {
      direction : output;
      function : "(A * B)";
    }
  }

  cell (OR2) {
    area : 2.0;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (B) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Y) {
      direction : output;
      function : "(A + B)";
    }
  }

  cell (DFF_P) {
    area : 4.0;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "D";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (Q) {
      direction : output;
      function : "IQ";
    }
  }

  cell (TIE1) {
    area : 1.0;
    pin (Y) {
      direction : output;
      function : "1";
    }
  }

  cell (TIE0) {
    area : 1.0;
    pin (Y) {
      direction : output;
      function : "0";
    }
  }

  cell (MULTIE) {
    area : 0.5;
    pin (HI) {
      direction : output;
      function : "1";
    }
    pin (LO) {
      direction : output;
      function : "0";
    }
  }

  cell (DFF_P_TIE0) {
    area : 4.0;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "(D + 0)";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (Q) {
      direction : output;
      function : "IQ";
    }
  }

  cell (DFF_P_TIE1) {
    area : 4.0;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "(D + 1)";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (Q) {
      direction : output;
      function : "IQ";
    }
  }

}
