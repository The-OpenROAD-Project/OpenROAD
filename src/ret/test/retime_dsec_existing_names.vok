module top (a,
    b,
    c,
    clk,
    e,
    rst_n,
    y,
    z);
 input a;
 input b;
 input c;
 input clk;
 input e;
 input rst_n;
 output y;
 output z;

 wire d1;
 wire d2;
 wire d3;
 wire d4;
 wire d5;
 wire m1;
 wire m2;
 wire m3;
 wire m4;
 wire n1;
 wire n2;
 wire n3;
 wire n4;
 wire ret_net_7;
 wire q6;
 wire ret_net_0;
 wire ret_net_1;
 wire unmap_net_3;
 wire unmap_state_1;
 wire ret_net_8;
 wire unmap_net_4;
 wire unmap_net_6;

 AND2_X1 g0 (.A1(a),
    .A2(rst_n),
    .ZN(d1));
 AND2_X1 g1 (.A1(b),
    .A2(rst_n),
    .ZN(d2));
 AND2_X1 g10 (.A1(c),
    .A2(rst_n),
    .ZN(d4));
 AND2_X1 g11 (.A1(e),
    .A2(rst_n),
    .ZN(d5));
 NAND2_X1 g12 (.A1(unmap_net_4),
    .A2(unmap_net_6),
    .ZN(m1));
 INV_X1 g13 (.A(m1),
    .ZN(m2));
 INV_X1 g14 (.A(m2),
    .ZN(m3));
 INV_X1 g15 (.A(m3),
    .ZN(m4));
 INV_X1 g16 (.A(ret_net_7),
    .ZN(unmap_net_3));
 AND2_X1 g17 (.A1(unmap_net_3),
    .A2(rst_n),
    .ZN(unmap_state_1));
 NAND2_X1 g2 (.A1(d1),
    .A2(d2),
    .ZN(n1));
 INV_X1 g3 (.A(n1),
    .ZN(n2));
 INV_X1 g4 (.A(n2),
    .ZN(n3));
 INV_X1 g5 (.A(n3),
    .ZN(n4));
 INV_X1 g6 (.A(ret_net_8),
    .ZN(ret_net_1));
 AND2_X1 g7 (.A1(ret_net_1),
    .A2(rst_n),
    .ZN(d3));
 BUF_X1 g8 (.A(ret_net_0),
    .Z(y));
 DFF_X1 ret_ff_0 (.D(d3),
    .CK(clk),
    .Q(ret_net_0));
 DFF_X1 ret_ff_6 (.D(m4),
    .CK(clk),
    .Q(ret_net_7));
 DFF_X1 ret_ff_7 (.D(n4),
    .CK(clk),
    .Q(ret_net_8));
 DFF_X1 unmap_ff_0 (.D(unmap_state_1),
    .CK(clk),
    .Q(q6));
 BUF_X1 unmap_inv_2 (.A(q6),
    .Z(z));
 INV_X1 unmap_inv_3 (.A(d4),
    .ZN(unmap_net_4));
 INV_X1 unmap_inv_5 (.A(d5),
    .ZN(unmap_net_6));
endmodule
