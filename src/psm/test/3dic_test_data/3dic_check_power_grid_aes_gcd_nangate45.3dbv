Header:
  version: 2.5
  unit: micron
  precision: 2000

ChipletDef:
  aes:
    type: die
    design_area: [620.15, 620.60]
    thickness: 100  # this is an assumed value as part of this test
    shrink: 1  # means no size scaling
    tsv: false # no tsv needed in the frontside 3d PDN

    regions: # used to describe on which metal layer bumps of this chiplet will be placed
      front_reg:  # front region
        side: front
        layer: metal5  # based on the bump lef
        coords:
          - [0, 0]             # x_min, y_min
          - [620.15, 0]        # x_max, y_min
          - [620.15, 620.60]   # x_max, y_max
          - [0, 620.60]        # x_min, y_max
        bmap: 3dic_check_power_grid_aes_gcd_nangate45_aes.bmap

      back_reg:  # back region
        side: back
        coords:
          - [0, 0]             # x_min, y_min
          - [620.15, 0]        # x_max, y_min
          - [620.15, 620.60]   # x_max, y_max
          - [0, 620.60]        # x_min, y_max

    external:
        APR_tech_file: [../Nangate45/Nangate45_tech.lef]
        LEF_file: [../Nangate45/Nangate45_stdcell.lef, ../Nangate45/fake_bumps.lef]
        liberty_file: [../Nangate45/Nangate45_typ.lib]
        DEF_file: [../Nangate45_data/aes.def]


  gcd:
    type: die
    design_area: [100.13, 100.80]
    thickness: 100  # this is an assumed value as part of this test
    shrink: 1  # means no size scaling
    tsv: false # no tsv needed in the frontside 3d PDN

    regions:
      front_reg:
        side: front
        layer: metal5
        coords:
          - [0, 0]              # x_min, y_min
          - [100.13, 0]         # x_max, y_min
          - [100.13, 100.80]    # x_max, y_max
          - [0, 100.80]         # x_min, y_max
        bmap: 3dic_check_power_grid_aes_gcd_nangate45_gcd.bmap

    external:
      APR_tech_file: [../Nangate45/Nangate45_tech.lef]
      LEF_file: [../Nangate45/Nangate45_stdcell.lef, ../Nangate45/fake_bumps.lef]
      # liberty_file: [../Nangate45/Nangate45_typ.lib]  #  this is already loaded during the AES run
      DEF_file: [../Nangate45_data/gcd.def]
