module top (clk,
    clk_n_o,
    d,
    q1,
    q2);
 input clk;
 output clk_n_o;
 input d;
 output q1;
 output q2;

 wire net3;

 INV_X1 c1_3 (.A(net3),
    .ZN(clk_n_o));
 mid m1 (.clk_in(clk),
    .d(d),
    .clk_n_out(net3),
    .q1(q1),
    .q2(q2));
endmodule
module mid (clk_in,
    d,
    clk_n_out,
    q1,
    q2);
 input clk_in;
 input d;
 output clk_n_out;
 output q1;
 output q2;


 regs u_regs (.ck(clk_in),
    .d(d),
    .q1(q1),
    .q2(q2));
 assign clk_n_out = clk_in;
endmodule
module regs (ck,
    d,
    q1,
    q2);
 input ck;
 input d;
 output q1;
 output q2;

 wire net_1;
 wire net_2;

 INV_X1 c1_1 (.A(ck),
    .ZN(net_1));
 INV_X1 c1_2 (.A(ck),
    .ZN(net_2));
 DFF_X1 r1 (.D(d),
    .CK(net_2),
    .Q(q1));
 DFF_X1 r2 (.D(d),
    .CK(net_1),
    .Q(q2));
endmodule
