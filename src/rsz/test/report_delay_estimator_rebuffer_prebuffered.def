VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN reg1 ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 80000 900000 ) ;

COMPONENTS 7 ;
- r1 DFF_X1 + PLACED   ( 10000 50000 ) N ;
- side_u1 BUF_X1 + PLACED   ( 30000 250000 ) N ;
- side_u2 BUF_X1 + PLACED   ( 60000 400000 ) N ;
- r2 DFF_X1 + PLACED   ( 20000 800000 ) N ;
- r3 DFF_X1 + PLACED   ( 40000 800000 ) N ;
- r4 DFF_X1 + PLACED   ( 30000 350000 ) N ;
- r5 DFF_X1 + PLACED   ( 60000 500000 ) N ;
END COMPONENTS

PINS 1 ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL
      + FIXED ( 10000 3333 ) N + LAYER metal2 ( 0 0 ) ( 0 0 ) ;
END PINS

SPECIALNETS 2 ;
- VSS  ( * VSS )
  + USE GROUND ;
- VDD  ( * VDD )
  + USE POWER ;
END SPECIALNETS

NETS 4 ;
- clk ( PIN clk ) ( r1 CK ) ( r2 CK ) ( r3 CK ) ( r4 CK ) ( r5 CK )
  + USE SIGNAL ;
- r1q ( r1 Q ) ( r2 D ) ( r3 D ) ( side_u1 A ) ( side_u2 A ) + USE SIGNAL ;
- side_u1z ( side_u1 Z ) ( r4 D ) + USE SIGNAL ;
- side_u2z ( side_u2 Z ) ( r5 D ) + USE SIGNAL ;
END NETS

END DESIGN
