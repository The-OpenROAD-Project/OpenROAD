VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN reg1 ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 200000 200000 ) ;

COMPONENTS 9 ;
- r1 DFF_X1 + PLACED   ( 100000 100000 ) N ;
- r2 DFF_X1 + PLACED   ( 20000 100000 ) N ;
- r3 DFF_X1 + PLACED   ( 50000 30000 ) N ;
- r4 DFF_X1 + PLACED   ( 100000 20000 ) N ;
- r5 DFF_X1 + PLACED   ( 150000 30000 ) N ;
- r6 DFF_X1 + PLACED   ( 180000 100000 ) N ;
- r7 DFF_X1 + PLACED   ( 150000 170000 ) N ;
- r8 DFF_X1 + PLACED   ( 100000 180000 ) N ;
- r9 DFF_X1 + PLACED   ( 50000 170000 ) N ;
END COMPONENTS

PINS 1 ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL
      + FIXED ( 100000 3333 ) N + LAYER metal2 ( 0 0 ) ( 0 0 ) ;
END PINS

SPECIALNETS 2 ;
- VSS  ( * VSS )
  + USE GROUND ;
- VDD  ( * VDD )
  + USE POWER ;
END SPECIALNETS

NETS 2 ;
- clk ( PIN clk ) ( r1 CK ) ( r2 CK ) ( r3 CK ) ( r4 CK ) ( r5 CK )
  ( r6 CK ) ( r7 CK ) ( r8 CK ) ( r9 CK ) + USE SIGNAL ;
- r1q ( r1 Q ) ( r2 D ) ( r3 D ) ( r4 D ) ( r5 D ) ( r6 D ) ( r7 D )
  ( r8 D ) ( r9 D ) + USE SIGNAL ;
END NETS

END DESIGN
