      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (cap_table) {
          values ("0.11, 0.38");
        }
        cell_fall (cap_table) {
          values ("0.07, 0.27");
        }
        rise_transition (cap_table) {
          values ("0.0, 2.50");
        }
        fall_transition (cap_table) {
          values ("0.0, 2.00");
        }
      }
    }
  }

