        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (cap_table) {
          values ("0.05, 0.16");
        }
        cell_fall (cap_table) {
          values ("0.20, 0.405");
        }
        rise_transition (cap_table) {
          values ("0.0, 2.00");
        }
        fall_transition (cap_table) {
          values ("0.0, 2.05");
        }
      }
    }
  }

