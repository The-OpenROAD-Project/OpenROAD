library (TestResizerSkewVt) {
  delay_model : table_lookup;
  time_unit : "1ns";
  leakage_power_unit : "1nW";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  capacitive_load_unit (1, pf);

  input_threshold_pct_rise : 50.0;
  input_threshold_pct_fall : 50.0;
  output_threshold_pct_rise : 50.0;
  output_threshold_pct_fall : 50.0;
  slew_lower_threshold_pct_rise : 20.0;
  slew_lower_threshold_pct_fall : 20.0;
  slew_upper_threshold_pct_rise : 80.0;
  slew_upper_threshold_pct_fall : 80.0;

  lu_table_template (cap_table) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.0, 1.0");
  }

  cell (SKEW_BUF_D1_RVT) {
    area : 1.0;
    cell_footprint : skew_buf;
    user_function_class : skew_buf;
    cell_leakage_power : 10.0;

    pin (A) {
      direction : input;
      capacitance : 0.01;
    }

    pin (Z) {
      direction : output;
      function : "A";
      max_capacitance : 10.0;

      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (cap_table) {
          values ("0.10, 0.37");
        }
        cell_fall (cap_table) {
          values ("0.08, 0.29");
        }
        rise_transition (cap_table) {
          values ("0.0, 2.70");
        }
        fall_transition (cap_table) {
          values ("0.0, 2.10");
        }
      }
    }
  }

  cell (SKEW_BUF_SKRD2_RVT) {
