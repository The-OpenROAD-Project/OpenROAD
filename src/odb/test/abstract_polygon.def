VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN polygon_block ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 0 200000 ) ( 200000 200000 ) ( 200000 100000 ) ( 100000 100000 ) ( 100000 0 ) ;
PINS 2 ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL
      + LAYER metal3 ( -1000 -100 ) ( 1000 100 ) + PLACED ( 10000 190000 ) N ;
    - out + NET out + DIRECTION OUTPUT + USE SIGNAL
      + LAYER metal3 ( -1000 -100 ) ( 1000 100 ) + PLACED ( 190000 110000 ) N ;
END PINS
SPECIALNETS 2 ;
    - VDD ( * VDD ) + USE POWER
      + ROUTED metal1 340 + SHAPE FOLLOWPIN ( 2000 50000 ) ( 98000 50000 )
      NEW metal1 340 + SHAPE FOLLOWPIN ( 2000 150000 ) ( 198000 150000 ) ;
    - VSS ( * VSS ) + USE GROUND
      + ROUTED metal1 340 + SHAPE FOLLOWPIN ( 2000 20000 ) ( 98000 20000 )
      NEW metal1 340 + SHAPE FOLLOWPIN ( 2000 180000 ) ( 198000 180000 ) ;
END SPECIALNETS
END DESIGN
