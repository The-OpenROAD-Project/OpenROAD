VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN write_def_mask ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 2000 2000 ) ;
COMPONENTS 0 ;
END COMPONENTS
NETS 2 ;
    - a + USE SIGNAL
      + ROUTED M1 ( 50 50 ) MASK 1 ( 950 * ) ;
    - b + USE SIGNAL
      + ROUTED M1 ( 50 150 ) MASK 1 ( 500 * ) MASK 2 ( 950 * ) ;
END NETS
END DESIGN
