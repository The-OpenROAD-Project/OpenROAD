VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN set_halo_test ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 1000000 1000000 ) ;
COMPONENTS 3 ;
    - BUF1 BUF_X1 + PLACED ( 700000 0 ) N ;
    - MACRO1 HM_100x100_1x1 + PLACED ( 0 0 ) N + HALO 1000 1000 1000 1000 ;
    - MACRO2 HM_100x100_1x1 + PLACED ( 400000 0 ) N + HALO 1000 1000 1000 1000 ;
END COMPONENTS
NETS 0 ;
END NETS
END DESIGN
