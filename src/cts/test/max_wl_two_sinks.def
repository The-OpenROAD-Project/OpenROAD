VERSION 5.7 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN max_wl_two_sinks ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 20000000 400000 ) ;

COMPONENTS 3 ;
- ff0 DFF_X1 + PLACED ( 20000 20000 ) N ;
- ff1 DFF_X1 + PLACED ( 1820000 20000 ) N ;
- ff2 DFF_X1 + PLACED ( 18000000 20000 ) N ;
END COMPONENTS

PINS 1 ;
- clk + NET clk + DIRECTION INPUT + USE SIGNAL
  + LAYER metal6 ( -140 0 ) ( 140 280 ) + FIXED ( 10000000 400000 ) S ;
END PINS

NETS 1 ;
- clk ( PIN clk ) ( ff0 CK ) ( ff1 CK ) ( ff2 CK ) ;
END NETS

END DESIGN
