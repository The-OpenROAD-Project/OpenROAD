VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN window_supply_mixed_rows_full ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 48000 8000 ) ;
ROW single_bottom REVIEW_SINGLE_SITE 0 0 N DO 24 BY 1 STEP 2000 0 ;
ROW double REVIEW_DOUBLE_SITE 0 2000 N DO 24 BY 1 STEP 2000 0 ;
ROW single_top REVIEW_SINGLE_SITE 0 6000 N DO 24 BY 1 STEP 2000 0 ;
COMPONENTS 27 ;
- tall0 REVIEW_TALL + PLACED ( 0 2000 ) N ;
- tall1 REVIEW_TALL + PLACED ( 8000 2000 ) N ;
- tall2 REVIEW_TALL + PLACED ( 16000 2000 ) N ;
- bottom0 REVIEW_SHORT + PLACED ( 0 0 ) N ;
- top0 REVIEW_SHORT + PLACED ( 0 6000 ) N ;
- bottom1 REVIEW_SHORT + PLACED ( 4000 0 ) N ;
- top1 REVIEW_SHORT + PLACED ( 4000 6000 ) N ;
- bottom2 REVIEW_SHORT + PLACED ( 8000 0 ) N ;
- top2 REVIEW_SHORT + PLACED ( 8000 6000 ) N ;
- bottom3 REVIEW_SHORT + PLACED ( 12000 0 ) N ;
- top3 REVIEW_SHORT + PLACED ( 12000 6000 ) N ;
- bottom4 REVIEW_SHORT + PLACED ( 16000 0 ) N ;
- top4 REVIEW_SHORT + PLACED ( 16000 6000 ) N ;
- bottom5 REVIEW_SHORT + PLACED ( 20000 0 ) N ;
- top5 REVIEW_SHORT + PLACED ( 20000 6000 ) N ;
- stack0 REVIEW_SHORT + PLACED ( 0 0 ) N ;
- stack1 REVIEW_SHORT + PLACED ( 0 0 ) N ;
- stack2 REVIEW_SHORT + PLACED ( 0 0 ) N ;
- stack3 REVIEW_SHORT + PLACED ( 0 0 ) N ;
- stack4 REVIEW_SHORT + PLACED ( 0 0 ) N ;
- stack5 REVIEW_SHORT + PLACED ( 0 0 ) N ;
- stack6 REVIEW_SHORT + PLACED ( 0 0 ) N ;
- stack7 REVIEW_SHORT + PLACED ( 0 0 ) N ;
- stack8 REVIEW_SHORT + PLACED ( 0 0 ) N ;
- stack9 REVIEW_SHORT + PLACED ( 0 0 ) N ;
- stack10 REVIEW_SHORT + PLACED ( 0 0 ) N ;
- stack11 REVIEW_SHORT + PLACED ( 0 0 ) N ;
END COMPONENTS
END DESIGN
