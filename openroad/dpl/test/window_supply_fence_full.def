VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN window_supply_fence_full ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 64000 8000 ) ;
ROW ROW_0 REVIEW_SINGLE_SITE 0 0 N DO 32 BY 1 STEP 2000 0 ;
ROW ROW_1 REVIEW_SINGLE_SITE 0 2000 N DO 32 BY 1 STEP 2000 0 ;
ROW ROW_2 REVIEW_SINGLE_SITE 0 4000 N DO 32 BY 1 STEP 2000 0 ;
ROW ROW_3 REVIEW_SINGLE_SITE 0 6000 N DO 32 BY 1 STEP 2000 0 ;
COMPONENTS 18 ;
- wide REVIEW_WIDE + PLACED ( 38000 4000 ) N ;
- member REVIEW_MEMBER + PLACED ( 48000 0 ) N ;
- stack0 REVIEW_MEMBER + PLACED ( 4000 0 ) N ;
- stack1 REVIEW_MEMBER + PLACED ( 4000 0 ) N ;
- stack2 REVIEW_MEMBER + PLACED ( 4000 0 ) N ;
- stack3 REVIEW_MEMBER + PLACED ( 4000 0 ) N ;
- stack4 REVIEW_MEMBER + PLACED ( 4000 0 ) N ;
- stack5 REVIEW_MEMBER + PLACED ( 4000 0 ) N ;
- stack6 REVIEW_MEMBER + PLACED ( 4000 0 ) N ;
- stack7 REVIEW_MEMBER + PLACED ( 4000 0 ) N ;
- stack8 REVIEW_MEMBER + PLACED ( 4000 0 ) N ;
- stack9 REVIEW_MEMBER + PLACED ( 4000 0 ) N ;
- stack10 REVIEW_MEMBER + PLACED ( 4000 0 ) N ;
- stack11 REVIEW_MEMBER + PLACED ( 4000 0 ) N ;
- stack12 REVIEW_MEMBER + PLACED ( 4000 0 ) N ;
- stack13 REVIEW_MEMBER + PLACED ( 4000 0 ) N ;
- stack14 REVIEW_MEMBER + PLACED ( 4000 0 ) N ;
- stack15 REVIEW_MEMBER + PLACED ( 4000 0 ) N ;
END COMPONENTS
REGIONS 1 ;
- fence ( 40000 0 ) ( 64000 8000 ) + TYPE FENCE ;
END REGIONS
GROUPS 1 ;
- fence_group member + REGION fence ;
END GROUPS
END DESIGN
