/* ========================================================================== */
/* sequnmap_basic.lib: hand sized liberty for unit testing SequentialUnmapper. */
/* Cell names follow the Yosys internal cell convention: */
/*   DFF_<clk edge P/N>            plain flop */
/*   DFFE_<clk edge><en polarity>  enable flop */
/*   DFF_<clk edge><rst polarity><rst value>   async clear/preset, for example DFF_PN0 */
/* Test only suffixes: _QN = publishes !state, _ND = stores !D as in the asap7 DFFHQN shape, */
/*   _TIE0/_TIE1 = next_state carries a constant leaf. */
/* The basic set: builders INV, AND2, OR2, TIE1, TIE0 plus one flop per code path: */
/*   DFF_P     base register */
/*   DFF_P_QN  output side inverter */
/*   DFF_P_ND  stores !D, input side inverter, area TRAP below DFF_P */
/*   DFF_P_2CK a second pin marked as a clock, area TRAP below DFF_P: never the base, */
/*             never unmapped */
/*   DFF_P_SL  an input the sequential does not read, area TRAP below DFF_P: a new cell */
/*             of it would leave that input open */
/*   DFF_P_TQ  a tri-state output: never the base, never unmapped */
/*   DFFE_PP   state feedback */
/*   DFF_PN0   async clear */
/* AND2_AA, OR2_AA  read A twice, area TRAP below AND2 and OR2: never builders */
/* INV_NA, DFF_P_NA  untimed, area TRAP below INV and DFF_P: never builders */
/* One scalar timing arc per signal pin: the unmapper builds only from cells */
/* STA times.  It reads functions, not delays. */
/* ========================================================================== */
library (sequnmap_basic) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, pf);
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  default_fanout_load : 1.0;
  default_inout_pin_cap : 0.001;
  default_input_pin_cap : 0.001;
  default_output_pin_cap : 0.0;

  cell (INV) {
    area : 1.0;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Y) {
      direction : output;
      function : "!A";
      timing () { related_pin : "A"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (AND2) {
    area : 2.0;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (B) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Y) {
      direction : output;
      function : "(A * B)";
      timing () { related_pin : "A"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
      timing () { related_pin : "B"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (OR2) {
    area : 2.0;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (B) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Y) {
      direction : output;
      function : "(A + B)";
      timing () { related_pin : "A"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
      timing () { related_pin : "B"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (AND2_AA) {
    area : 1.5;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (B) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Y) {
      direction : output;
      function : "(A * A)";
      timing () { related_pin : "A"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
      timing () { related_pin : "B"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (OR2_AA) {
    area : 1.5;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (B) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Y) {
      direction : output;
      function : "(A + A)";
      timing () { related_pin : "A"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
      timing () { related_pin : "B"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (INV_NA) {
    area : 0.5;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Y) {
      direction : output;
      function : "!A";
    }
  }

  /* two input mux: Y = S ? A1 : A0. Lets a test check that a next_state */
  /* shaped like D * EN + IQ * !EN can be recognized and built as ONE */
  /* cell instead of a 2xAND2 + OR2 + INV cone, the findMux2 idea. Area sits */
  /* between a single gate and the 4 gate cone it replaces. */
  cell (MUX2) {
    area : 3.0;
    pin (A0) {
      direction : input;
      capacitance : 0.001;
    }
    pin (A1) {
      direction : input;
      capacitance : 0.001;
    }
    pin (S) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Y) {
      direction : output;
      function : "(A0 * !S) + (A1 * S)";
      timing () { related_pin : "A0"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
      timing () { related_pin : "A1"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
      timing () { related_pin : "S"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (TIE1) {
    area : 1.0;
    pin (Y) {
      direction : output;
      function : "1";
    }
  }

  cell (TIE0) {
    area : 1.0;
    pin (Y) {
      direction : output;
      function : "0";
    }
  }

  cell (DFF_P) {
    area : 4.0;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "D";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (DFF_P_QN) {
    area : 4.0;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "D";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (QN) {
      direction : output;
      function : "IQN";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (DFF_P_2CK) {
    area : 3.0;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "D";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (CK2) {
      direction : input;
      clock : true;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (DFF_P_SL) {
    area : 2.5;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "D";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (SL) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (DFF_P_ND) {
    area : 3.5;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "!D";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (QN) {
      direction : output;
      function : "IQ";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (DFFE_PP) {
    area : 5.0;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "(D * EN) + (IQ * !EN)";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (EN) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (DFF_PN0) {
    area : 5.0;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "D";
      clear : "!RN";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (RN) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (DFF_P_TQ) {
    area : 2.0;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "D";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (OE) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      three_state : "!OE";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (DFF_P_NA) {
    area : 1.5;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "D";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (Q) {
      direction : output;
      function : "IQ";
    }
  }

}
