module top (a,
    b,
    c,
    clk,
    e,
    rst_n,
    w,
    y);
 input a;
 input b;
 input c;
 input clk;
 input e;
 input rst_n;
 output w;
 output y;

 wire d1;
 wire d3;
 wire d4;
 wire d5;
 wire d6;
 wire m1;
 wire m2;
 wire m3;
 wire m4;
 wire m5;
 wire n1;
 wire n2;
 wire n3;
 wire n4;
 wire n5;
 wire n6;
 wire q1;
 wire q3;
 wire ret_net_2;
 wire q6;
 wire qp;

 AND2_X1 g0 (.A1(b),
    .A2(rst_n),
    .ZN(d1));
 AND2_X1 g10 (.A1(c),
    .A2(rst_n),
    .ZN(d4));
 AND2_X1 g11 (.A1(e),
    .A2(rst_n),
    .ZN(d5));
 NAND2_X1 g12 (.A1(d4),
    .A2(d5),
    .ZN(m1));
 INV_X1 g13 (.A(m1),
    .ZN(m2));
 INV_X1 g14 (.A(m2),
    .ZN(m3));
 INV_X1 g15 (.A(m3),
    .ZN(m4));
 INV_X1 g16 (.A(m4),
    .ZN(m5));
 AND2_X1 g17 (.A1(ret_net_2),
    .A2(rst_n),
    .ZN(d6));
 BUF_X1 g18 (.A(q6),
    .Z(w));
 NAND2_X1 g2 (.A1(qp),
    .A2(q1),
    .ZN(n1));
 INV_X1 g3 (.A(n1),
    .ZN(n2));
 INV_X1 g4 (.A(n2),
    .ZN(n3));
 INV_X1 g5 (.A(n3),
    .ZN(n4));
 INV_X1 g6 (.A(n4),
    .ZN(n5));
 INV_X1 g6b (.A(n5),
    .ZN(n6));
 AND2_X1 g7 (.A1(n6),
    .A2(rst_n),
    .ZN(d3));
 BUF_X1 g8 (.A(q3),
    .Z(y));
 DFF_X1 r1 (.D(d1),
    .CK(clk),
    .Q(q1));
 DFF_X1 r3 (.D(d3),
    .CK(clk),
    .Q(q3));
 DFF_X1 r6 (.D(d6),
    .CK(clk),
    .Q(q6));
 DFF_X1 ret_ff_2 (.D(m5),
    .CK(clk),
    .Q(ret_net_2));
 DFF_X1 rp (.D(a),
    .CK(clk),
    .Q(qp));
endmodule
