module top (a,
    clk,
    rst_n,
    z);
 input a;
 input clk;
 input rst_n;
 output z;

 wire d1;
 wire n1;
 wire n2;
 wire n3;
 wire n4;
 wire ret_net_1;

 AND2_X1 g0 (.A1(a),
    .A2(rst_n),
    .ZN(d1));
 INV_X1 i1 (.A(d1),
    .ZN(n1));
 INV_X1 i2 (.A(n1),
    .ZN(n2));
 INV_X1 i3 (.A(n2),
    .ZN(n3));
 INV_X1 i4 (.A(ret_net_1),
    .ZN(n4));
 DFF_X1 ret_ff_1 (.D(n3),
    .CK(clk),
    .Q(ret_net_1));
 DFF_X1 rz (.D(n4),
    .CK(clk),
    .Q(z));
endmodule
