module top (a,
    b,
    c,
    clk,
    d,
    rst_n,
    y,
    z);
 input a;
 input b;
 input c;
 input clk;
 input d;
 input rst_n;
 output y;
 output z;


 mid u_mid (.a(a),
    .b(b),
    .c(c),
    .d(d),
    .rn(rst_n),
    .ck(clk),
    .y(y),
    .z(z));
endmodule
module leaf_a (a,
    b,
    rn,
    ck,
    y);
 input a;
 input b;
 input rn;
 input ck;
 output y;

 wire d1;
 wire d2;
 wire d3;
 wire n1;
 wire n2;
 wire n3;
 wire n4;
 wire n5;
 wire n6;
 wire q1n;
 wire q2n;
 wire q3;

 AND2_X1 g0 (.A1(a),
    .A2(rn),
    .ZN(d1));
 AND2_X1 g1 (.A1(b),
    .A2(rn),
    .ZN(d2));
 NAND2_X1 g2 (.A1(q1n),
    .A2(q2n),
    .ZN(n1));
 INV_X1 g3 (.A(n1),
    .ZN(n2));
 INV_X1 g4 (.A(n2),
    .ZN(n3));
 INV_X1 g5 (.A(n3),
    .ZN(n4));
 INV_X1 g6 (.A(n4),
    .ZN(n5));
 INV_X1 g7 (.A(n5),
    .ZN(n6));
 AND2_X1 g8 (.A1(n6),
    .A2(rn),
    .ZN(d3));
 BUF_X1 g9 (.A(q3),
    .Z(y));
 DFF_X1 r1 (.D(d1),
    .CK(ck),
    .QN(q1n));
 DFF_X1 r2 (.D(d2),
    .CK(ck),
    .QN(q2n));
 DFF_X1 r3 (.D(d3),
    .CK(ck),
    .Q(q3));
endmodule
module leaf_b (a,
    b,
    rn,
    ck,
    y);
 input a;
 input b;
 input rn;
 input ck;
 output y;

 wire d1;
 wire d2;
 wire d3;
 wire n1;
 wire n2;
 wire n3;
 wire n4;
 wire q1n;
 wire q2n;
 wire q3;

 AND2_X1 g0 (.A1(a),
    .A2(rn),
    .ZN(d1));
 AND2_X1 g1 (.A1(b),
    .A2(rn),
    .ZN(d2));
 NAND2_X1 g2 (.A1(q1n),
    .A2(q2n),
    .ZN(n1));
 INV_X1 g3 (.A(n1),
    .ZN(n2));
 INV_X1 g4 (.A(n2),
    .ZN(n3));
 INV_X1 g5 (.A(n3),
    .ZN(n4));
 AND2_X1 g8 (.A1(n4),
    .A2(rn),
    .ZN(d3));
 BUF_X1 g9 (.A(q3),
    .Z(y));
 DFF_X1 r1 (.D(d1),
    .CK(ck),
    .QN(q1n));
 DFF_X1 r2 (.D(d2),
    .CK(ck),
    .QN(q2n));
 DFF_X1 r3 (.D(d3),
    .CK(ck),
    .Q(q3));
endmodule
module mid (a,
    b,
    c,
    d,
    rn,
    ck,
    y,
    z);
 input a;
 input b;
 input c;
 input d;
 input rn;
 input ck;
 output y;
 output z;


 leaf_a u_a (.a(a),
    .b(b),
    .rn(rn),
    .ck(ck),
    .y(y));
 leaf_b u_b (.a(c),
    .b(d),
    .rn(rn),
    .ck(ck),
    .y(z));
endmodule
