module top (a,
    b,
    clk,
    y);
 input a;
 input b;
 input clk;
 output y;

 wire n0;
 wire n1;
 wire n2;
 wire n3;
 wire n4;
 wire q1;
 wire q2;

 AND2_X1 g0 (.A1(a),
    .A2(b),
    .ZN(n0));
 INV_X1 g1 (.A(q1),
    .ZN(n1));
 INV_X1 g2 (.A(n1),
    .ZN(n2));
 INV_X1 g3 (.A(n2),
    .ZN(n3));
 INV_X1 g4 (.A(n3),
    .ZN(n4));
 BUF_X1 g5 (.A(q2),
    .Z(y));
 DFF_X1 r1 (.D(n0),
    .CK(clk),
    .Q(q1));
 DFF_X1 r2 (.D(n4),
    .CK(clk),
    .Q(q2));
endmodule
