module top (a,
    b,
    clk,
    en_i,
    rst_n,
    y,
    z);
 input a;
 input b;
 input clk;
 input en_i;
 input rst_n;
 output y;
 output z;

 wire d1;
 wire d2;
 wire d3;
 wire d4;
 wire en;
 wire m1;
 wire m2;
 wire m3;
 wire m4;
 wire n1;
 wire n2;
 wire n3;
 wire n4;
 wire q2;
 wire q4;
 wire qg;
 wire rst;
 wire ret_net_1;

 AND2_X1 g0 (.A1(a),
    .A2(rst_n),
    .ZN(d1));
 INV_X1 g1 (.A(d1),
    .ZN(n1));
 INV_X1 g10 (.A(m2),
    .ZN(m3));
 INV_X1 g11 (.A(m3),
    .ZN(m4));
 AND2_X1 g12 (.A1(m4),
    .A2(rst_n),
    .ZN(d4));
 BUF_X1 g13 (.A(q4),
    .Z(z));
 INV_X1 g2 (.A(n1),
    .ZN(n2));
 INV_X1 g3 (.A(n2),
    .ZN(n3));
 INV_X1 g4 (.A(n3),
    .ZN(n4));
 AND2_X1 g5 (.A1(ret_net_1),
    .A2(rst_n),
    .ZN(d2));
 BUF_X1 g6 (.A(q2),
    .Z(y));
 AND2_X1 g7 (.A1(b),
    .A2(rst_n),
    .ZN(d3));
 INV_X1 g8 (.A(qg),
    .ZN(m1));
 INV_X1 g9 (.A(m1),
    .ZN(m2));
 OR2_X1 g_e (.A1(en_i),
    .A2(rst),
    .ZN(en));
 INV_X1 g_r (.A(rst_n),
    .ZN(rst));
 DFF_X1 r2 (.D(d2),
    .CK(clk),
    .Q(q2));
 DFF_X1 r3 (.D(d4),
    .CK(clk),
    .Q(q4));
 DFF_X1 ret_ff_1 (.D(n4),
    .CK(clk),
    .Q(ret_net_1));
 DFFG_X1 rg (.D(d3),
    .CK(clk),
    .EN(en),
    .Q(qg));
endmodule
