module top (a,
    b,
    clk,
    rst_n,
    y);
 input a;
 input b;
 input clk;
 input rst_n;
 output y;

 wire d1;
 wire d2;
 wire d3;
 wire n1;
 wire n2;
 wire n3;
 wire n4;
 wire n5;
 wire n6;
 wire q3;
 wire ret_net_1;

 AND2_X1 g0 (.A1(a),
    .A2(rst_n),
    .ZN(d1));
 AND2_X1 g1 (.A1(b),
    .A2(rst_n),
    .ZN(d2));
 NAND2_X1 g2 (.A1(d1),
    .A2(d2),
    .ZN(n1));
 INV_X1 g3 (.A(n1),
    .ZN(n2));
 INV_X1 g4 (.A(n2),
    .ZN(n3));
 INV_X1 g5 (.A(n3),
    .ZN(n4));
 INV_X1 g6 (.A(n4),
    .ZN(n5));
 INV_X1 g7 (.A(n5),
    .ZN(n6));
 AND2_X1 g8 (.A1(ret_net_1),
    .A2(rst_n),
    .ZN(d3));
 BUF_X1 g9 (.A(q3),
    .Z(y));
 DFF_X1 r3 (.D(d3),
    .CK(clk),
    .Q(q3));
 DFF_X1 ret_ff_1 (.D(n6),
    .CK(clk),
    .Q(ret_net_1));
endmodule
