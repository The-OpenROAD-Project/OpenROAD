module top (a,
    clk,
    rst_n,
    y);
 input a;
 input clk;
 input rst_n;
 output y;

 wire d_in;
 wire d_l1;
 wire ret_net_1;
 wire q_l2;
 wire q_rst;
 wire rb;
 wire x0;
 wire x1;
 wire x10;
 wire x2;
 wire x3;
 wire x4;
 wire x5;
 wire x6;
 wire x7;
 wire x8;
 wire x9;

 AND2_X1 g_and (.A1(q_l2),
    .A2(q_rst),
    .ZN(d_l1));
 AND2_X1 g_in (.A1(a),
    .A2(rst_n),
    .ZN(d_in));
 BUF_X1 g_o (.A(q_l2),
    .Z(y));
 BUF_X1 g_r (.A(rst_n),
    .Z(rb));
 XOR2_X1 g_x (.A(d_l1),
    .B(d_in),
    .Z(x0));
 INV_X1 i1 (.A(ret_net_1),
    .ZN(x1));
 INV_X1 i10 (.A(x9),
    .ZN(x10));
 INV_X1 i2 (.A(x1),
    .ZN(x2));
 INV_X1 i3 (.A(x2),
    .ZN(x3));
 INV_X1 i4 (.A(x3),
    .ZN(x4));
 INV_X1 i5 (.A(x4),
    .ZN(x5));
 INV_X1 i6 (.A(x5),
    .ZN(x6));
 INV_X1 i7 (.A(x6),
    .ZN(x7));
 INV_X1 i8 (.A(x7),
    .ZN(x8));
 INV_X1 i9 (.A(x8),
    .ZN(x9));
 DFF_X1 rL2 (.D(x10),
    .CK(clk),
    .Q(q_l2));
 DFF_X1 rR (.D(rb),
    .CK(clk),
    .Q(q_rst));
 DFF_X1 ret_ff_1 (.D(x0),
    .CK(clk),
    .Q(ret_net_1));
endmodule
