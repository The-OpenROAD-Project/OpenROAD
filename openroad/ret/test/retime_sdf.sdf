(DELAYFILE
 (SDFVERSION "3.0")
 (DESIGN "top")
 (DIVIDER /)
 (TIMESCALE 1ns)
 (CELL
  (CELLTYPE "top")
  (INSTANCE)
  (DELAY
   (ABSOLUTE
    (INTERCONNECT g0/ZN r1/D (0.010::0.010) (0.010::0.010))
    (INTERCONNECT r1/Q g1/A (0.010::0.010) (0.010::0.010))
    (INTERCONNECT g1/ZN g2/A (0.010::0.010) (0.010::0.010))
    (INTERCONNECT g2/ZN g3/A (0.010::0.010) (0.010::0.010))
    (INTERCONNECT g3/ZN g4/A (0.010::0.010) (0.010::0.010))
    (INTERCONNECT g4/ZN r2/D (0.010::0.010) (0.010::0.010))
    (INTERCONNECT r2/Q g5/A (0.010::0.010) (0.010::0.010))
   )
  )
 )
)
