module top (a,
    b,
    c,
    clk,
    rst_n,
    y,
    z);
 input a;
 input b;
 input c;
 input clk;
 input rst_n;
 output y;
 output z;

 wire so;
 wire qc;
 wire dc;
 wire dz;
 wire qz;

 DFF_X1 rt1 (.D(dc),
    .CK(clk),
    .Q(qc));
 DFF_X1 rt2 (.D(dz),
    .CK(clk),
    .Q(qz));
 AND2_X1 t0 (.A1(c),
    .A2(rst_n),
    .ZN(dc));
 AND2_X1 t1 (.A1(so),
    .A2(rst_n),
    .ZN(dz));
 BUF_X1 t2 (.A(qz),
    .Z(z));
 core u_core (.a(a),
    .b(b),
    .rn(rst_n),
    .ck(clk),
    .y(y));
 stage u_stage (.i(qc),
    .o(so));
endmodule
module core (a,
    b,
    rn,
    ck,
    y);
 input a;
 input b;
 input rn;
 input ck;
 output y;

 wire d1;
 wire d2;
 wire d3;
 wire n1;
 wire n2;
 wire n3;
 wire n4;
 wire n5;
 wire n6;
 wire q3;
 wire ret_net_1;

 AND2_X1 g0 (.A1(a),
    .A2(rn),
    .ZN(d1));
 AND2_X1 g1 (.A1(b),
    .A2(rn),
    .ZN(d2));
 NAND2_X1 g2 (.A1(d1),
    .A2(d2),
    .ZN(n1));
 INV_X1 g3 (.A(n1),
    .ZN(n2));
 INV_X1 g4 (.A(n2),
    .ZN(n3));
 INV_X1 g5 (.A(n3),
    .ZN(n4));
 INV_X1 g6 (.A(n4),
    .ZN(n5));
 INV_X1 g7 (.A(n5),
    .ZN(n6));
 AND2_X1 g8 (.A1(ret_net_1),
    .A2(rn),
    .ZN(d3));
 BUF_X1 g9 (.A(q3),
    .Z(y));
 DFF_X1 r3 (.D(d3),
    .CK(ck),
    .Q(q3));
 DFF_X1 ret_ff_1 (.D(n6),
    .CK(ck),
    .Q(ret_net_1));
endmodule
module stage (i,
    o);
 input i;
 output o;

 wire s1;
 wire s2;
 wire s3;

 INV_X1 h1 (.A(i),
    .ZN(s1));
 INV_X1 h2 (.A(s1),
    .ZN(s2));
 INV_X1 h3 (.A(s2),
    .ZN(s3));
 INV_X1 h4 (.A(s3),
    .ZN(o));
endmodule
