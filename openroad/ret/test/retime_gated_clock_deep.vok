module top (a,
    b,
    clk,
    en,
    v,
    w,
    y,
    z);
 input a;
 input b;
 input clk;
 input en;
 output v;
 output w;
 output y;
 output z;

 wire gclk;
 wire m1;
 wire m2;
 wire m3;
 wire m4;
 wire n0;
 wire n1;
 wire pa;
 wire pb;
 wire q0;
 wire q2;
 wire qa;
 wire qb;
 wire qc;
 wire qd;
 wire ret_net_1;

 AND2_X1 g0 (.A1(a),
    .A2(b),
    .ZN(n0));
 OR2_X1 g1 (.A1(a),
    .A2(b),
    .ZN(n1));
 INV_X1 h1 (.A(n0),
    .ZN(m1));
 INV_X1 h2 (.A(m1),
    .ZN(m2));
 INV_X1 h3 (.A(m2),
    .ZN(m3));
 INV_X1 h4 (.A(ret_net_1),
    .ZN(m4));
 CLKGATE_X1 icg (.CK(clk),
    .E(en),
    .GCK(gclk));
 BUF_X1 o0 (.A(q0),
    .Z(z));
 BUF_X1 o1 (.A(q2),
    .Z(y));
 BUF_X1 o2 (.A(qc),
    .Z(v));
 BUF_X1 o3 (.A(qd),
    .Z(w));
 INV_X1 p1 (.A(qa),
    .ZN(pa));
 INV_X1 p2 (.A(qb),
    .ZN(pb));
 DFF_X1 r0 (.D(b),
    .CK(clk),
    .Q(q0));
 DFF_X1 r2 (.D(m4),
    .CK(gclk),
    .Q(q2));
 DFF_X1 ra (.D(n1),
    .CK(clk),
    .Q(qa));
 DFF_X1 rb (.D(n1),
    .CK(gclk),
    .Q(qb));
 DFF_X1 rc (.D(pa),
    .CK(clk),
    .Q(qc));
 DFF_X1 rd (.D(pb),
    .CK(gclk),
    .Q(qd));
 DFF_X1 ret_ff_1 (.D(m3),
    .CK(gclk),
    .Q(ret_net_1));
endmodule
