/* ========================================================================== */
/* sequnmap_two_outputs.lib: the sequnmap_basic cells plus two flops with two */
/* outputs, for unit testing SequentialUnmapper: */
/*   DFF_P_QQN  publishes the state on Q and !state on QN */
/*   DFF_P_ODD  Q publishes the state, Y a function of the state and D */
/* One scalar timing arc per signal pin: the unmapper builds only from cells */
/* STA times.  It reads functions, not delays. */
/* ========================================================================== */
library (sequnmap_two_outputs) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, pf);
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  default_fanout_load : 1.0;
  default_inout_pin_cap : 0.001;
  default_input_pin_cap : 0.001;
  default_output_pin_cap : 0.0;

  cell (INV) {
    area : 1.0;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Y) {
      direction : output;
      function : "!A";
      timing () { related_pin : "A"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (AND2) {
    area : 2.0;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (B) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Y) {
      direction : output;
      function : "(A * B)";
      timing () { related_pin : "A"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
      timing () { related_pin : "B"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (OR2) {
    area : 2.0;
    pin (A) {
      direction : input;
      capacitance : 0.001;
    }
    pin (B) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Y) {
      direction : output;
      function : "(A + B)";
      timing () { related_pin : "A"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
      timing () { related_pin : "B"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  /* two input mux: Y = S ? A1 : A0. Lets a test check that a next_state */
  /* shaped like D * EN + IQ * !EN can be recognized and built as ONE */
  /* cell instead of a 2xAND2 + OR2 + INV cone, the findMux2 idea. Area sits */
  /* between a single gate and the 4 gate cone it replaces. */
  cell (MUX2) {
    area : 3.0;
    pin (A0) {
      direction : input;
      capacitance : 0.001;
    }
    pin (A1) {
      direction : input;
      capacitance : 0.001;
    }
    pin (S) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Y) {
      direction : output;
      function : "(A0 * !S) + (A1 * S)";
      timing () { related_pin : "A0"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
      timing () { related_pin : "A1"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
      timing () { related_pin : "S"; cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (TIE1) {
    area : 1.0;
    pin (Y) {
      direction : output;
      function : "1";
    }
  }

  cell (TIE0) {
    area : 1.0;
    pin (Y) {
      direction : output;
      function : "0";
    }
  }

  cell (DFF_P) {
    area : 4.0;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "D";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (DFF_P_QN) {
    area : 4.0;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "D";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (QN) {
      direction : output;
      function : "IQN";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (DFF_P_ND) {
    area : 3.5;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "!D";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (QN) {
      direction : output;
      function : "IQ";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (DFFE_PP) {
    area : 5.0;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "(D * EN) + (IQ * !EN)";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (EN) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (DFF_PN0) {
    area : 5.0;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "D";
      clear : "!RN";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (RN) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (DFF_P_QQN) {
    area : 5.0;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "D";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
    pin (QN) {
      direction : output;
      function : "IQN";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

  cell (DFF_P_ODD) {
    area : 5.0;
    ff (IQ, IQN) {
      clocked_on : "CK";
      next_state : "D";
    }
    pin (D) {
      direction : input;
      capacitance : 0.001;
      timing () { related_pin : "CK"; timing_type : setup_rising;
                  rise_constraint (scalar) { values ("0.01"); } }
    }
    pin (CK) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
    pin (Y) {
      direction : output;
      function : "IQ & D";
      timing () { related_pin : "CK"; timing_type : rising_edge;
                  cell_rise (scalar) { values ("0.01"); }
                  rise_transition (scalar) { values ("0.01"); } }
    }
  }

}
