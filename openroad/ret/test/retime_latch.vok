module top (a,
    b,
    c,
    clk,
    y,
    z);
 input a;
 input b;
 input c;
 input clk;
 output y;
 output z;

 wire l1;
 wire n0;
 wire n1;
 wire n2;
 wire n3;
 wire n4;
 wire q2;
 wire ret_net_1;

 AND2_X1 g0 (.A1(a),
    .A2(b),
    .ZN(n0));
 INV_X1 g1 (.A(n0),
    .ZN(n1));
 INV_X1 g2 (.A(n1),
    .ZN(n2));
 INV_X1 g3 (.A(n2),
    .ZN(n3));
 INV_X1 g4 (.A(ret_net_1),
    .ZN(n4));
 BUF_X1 g5 (.A(q2),
    .Z(y));
 BUF_X1 g6 (.A(l1),
    .Z(z));
 DLL_X1 lat (.D(c),
    .GN(clk),
    .Q(l1));
 DFF_X1 r2 (.D(n4),
    .CK(clk),
    .Q(q2));
 DFF_X1 ret_ff_1 (.D(n3),
    .CK(clk),
    .Q(ret_net_1));
endmodule
