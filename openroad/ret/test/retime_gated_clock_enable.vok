module top (a,
    b,
    clk,
    rst_n,
    y);
 input a;
 input b;
 input clk;
 input rst_n;
 output y;

 wire d1;
 wire de;
 wire e1;
 wire e2;
 wire e3;
 wire e4;
 wire gclk;
 wire q1;
 wire qe;

 sky130_fd_sc_hd__and2_1 g0 (.A(a),
    .B(rst_n),
    .X(de));
 sky130_fd_sc_hd__and2_1 g1 (.A(b),
    .B(rst_n),
    .X(d1));
 sky130_fd_sc_hd__buf_1 g9 (.A(q1),
    .X(y));
 sky130_fd_sc_hd__inv_1 i1 (.A(qe),
    .Y(e1));
 sky130_fd_sc_hd__inv_1 i2 (.A(e1),
    .Y(e2));
 sky130_fd_sc_hd__inv_1 i3 (.A(e2),
    .Y(e3));
 sky130_fd_sc_hd__inv_1 i4 (.A(e3),
    .Y(e4));
 sky130_fd_sc_hd__dlclkp_1 icg (.GATE(e4),
    .GCLK(gclk),
    .CLK(clk));
 sky130_fd_sc_hd__dfxtp_1 r1 (.D(d1),
    .Q(q1),
    .CLK(gclk));
 sky130_fd_sc_hd__dfxtp_1 re (.D(de),
    .Q(qe),
    .CLK(clk));
endmodule
