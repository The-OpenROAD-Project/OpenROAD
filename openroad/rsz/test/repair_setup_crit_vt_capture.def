VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN crit_vt_capture ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 20000 1000 ) ;
ROW ROW_0 asap7sc7p5t 0 0 N DO 370 BY 1 STEP 54 0 ;
COMPONENTS 1 ;
    - cap DFFHQNx1_ASAP7_75t_R + PLACED ( 1026 0 ) N ;
END COMPONENTS
PINS 2 ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL ;
    - d_in + NET d_in + DIRECTION INPUT + USE SIGNAL ;
END PINS
NETS 2 ;
    - clk ( PIN clk ) ( cap CLK ) + USE SIGNAL ;
    - d_in ( PIN d_in ) ( cap D ) + USE SIGNAL ;
END NETS
END DESIGN
