VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN clk_data_path_vt ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 20000 1000 ) ;
ROW ROW_0 asap7sc7p5t 0 0 N DO 370 BY 1 STEP 54 0 ;
COMPONENTS 9 ;
    - drvr DFFHQNx1_ASAP7_75t_R + PLACED ( 1026 0 ) N ;
    - load0 INVx4_ASAP7_75t_R + PLACED ( 1026 0 ) N ;
    - load1 INVx4_ASAP7_75t_R + PLACED ( 1080 0 ) N ;
    - load2 INVx4_ASAP7_75t_R + PLACED ( 1134 0 ) N ;
    - load3 INVx4_ASAP7_75t_R + PLACED ( 1188 0 ) N ;
    - load4 INVx4_ASAP7_75t_R + PLACED ( 1242 0 ) N ;
    - load5 INVx4_ASAP7_75t_R + PLACED ( 1296 0 ) N ;
    - load6 INVx4_ASAP7_75t_R + PLACED ( 1350 0 ) N ;
    - load7 INVx4_ASAP7_75t_R + PLACED ( 1404 0 ) N ;
END COMPONENTS
PINS 2 ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL ;
    - d_in + NET d_in + DIRECTION INPUT + USE SIGNAL ;
END PINS
NETS 3 ;
    - clk ( PIN clk ) ( drvr CLK ) + USE SIGNAL ;
    - d_in ( PIN d_in ) ( drvr D ) + USE SIGNAL ;
    - q ( drvr QN ) ( load0 A ) ( load1 A ) ( load2 A ) ( load3 A ) ( load4 A ) ( load5 A ) ( load6 A ) ( load7 A ) + USE SIGNAL ;
END NETS
END DESIGN
