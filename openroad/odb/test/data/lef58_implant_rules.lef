VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;

UNITS
  DATABASE MICRONS 1000 ;
END UNITS

MANUFACTURINGGRID 0.01 ;

PROPERTYDEFINITIONS
  LAYER LEF58_CORNERSPACING STRING ;
  LAYER LEF58_MAXSPACING STRING ;
  LAYER LEF58_MINENCLOSEDAREA STRING ;
  LAYER LEF58_MINSTEP STRING ;
END PROPERTYDEFINITIONS

LAYER IMP1
  TYPE IMPLANT ;
  WIDTH 3.5 ;
  SPACING 1.5 ;
  PROPERTY LEF58_CORNERSPACING "
    CORNERSPACING 3.8 CHECKIMPLANTGROUPONLY ALIGNEDONLY ;
    CORNERSPACING 2.2 ALIGNEDONLY ; " ;
  PROPERTY LEF58_MAXSPACING "
    MAXSPACING 9.5 WIDTH 4.2 LENGTH 3.1 ; " ;
  PROPERTY LEF58_MINENCLOSEDAREA "
    MINENCLOSEDAREA 18.0 ;
    MINENCLOSEDAREA 14.5 WIDTH 2.8 ; " ;
  PROPERTY LEF58_MINSTEP "
    MINSTEP 4.8 MINADJACENTLENGTH 2.4 ; " ;
END IMP1

END LIBRARY
