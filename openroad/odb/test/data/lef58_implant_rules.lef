VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;

UNITS
  DATABASE MICRONS 1000 ;
END UNITS

MANUFACTURINGGRID 0.01 ;

PROPERTYDEFINITIONS
  LAYER LEF58_CORNERSPACING STRING ;
  LAYER LEF58_MAXSPACING STRING ;
  LAYER LEF58_MINENCLOSEDAREA STRING ;
  LAYER LEF58_MINSTEP STRING ;
  LAYER LEF58_WIDTH STRING ;
END PROPERTYDEFINITIONS

LAYER IMP2
  TYPE IMPLANT ;
  WIDTH 3.5 ;
  SPACING 1.5 ;
END IMP2

LAYER SUB_A
  TYPE MASTERSLICE ;
END SUB_A

LAYER IMP1
  TYPE IMPLANT ;
  WIDTH 3.5 ;
  SPACING 1.5 ;
  PROPERTY LEF58_CORNERSPACING "
    CORNERSPACING 3.8 CHECKIMPLANTGROUPONLY ALIGNEDONLY ;
    CORNERSPACING 2.2 ALIGNEDONLY ; " ;
  PROPERTY LEF58_MAXSPACING "
    MAXSPACING 9.5 WIDTH 4.2 LENGTH 3.1 ; " ;
  PROPERTY LEF58_MINENCLOSEDAREA "
    MINENCLOSEDAREA 18.0 ;
    MINENCLOSEDAREA 14.5 WIDTH 2.8 ; " ;
  PROPERTY LEF58_MINSTEP "
    MINSTEP 4.8 MINADJACENTLENGTH 2.4 ; " ;
  PROPERTY LEF58_WIDTH "
    WIDTH 3.6 LAYER IMP2 ZEROPRL CHECKIMPLANTGROUP GRP1 ;
    WIDTH 2.7 WITHINLAYER SUB_A ;
    WIDTH 4.4 CELLHEIGHT 8.8 LAYER SUB_B ;
    WIDTH 1.9 ZEROPRL MAXWIDTH 7.2 EXCEPTCORNERTOUCH LENGTH 5.1 ;
    WIDTH 2.1 LAYER ANY MAXWIDTH 6.4 LENGTH 4.3 ; " ;
END IMP1

LAYER SUB_B
  TYPE MASTERSLICE ;
END SUB_B

END LIBRARY
